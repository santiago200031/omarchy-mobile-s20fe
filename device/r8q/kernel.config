# SPDX-License-Identifier: MIT
# Samsung Galaxy S20 FE (r8q / SM8250) kernel config fragment.
# Merged on top of arm64 defconfig and omamobile.config.

# Qualcomm SM8250 SoC essentials
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_GPUCC_8250=m
CONFIG_SM_DISPCC_8250=y
CONFIG_QCOM_GPI_DMA=y

# Storage: Qualcomm UFS
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y

# USB & Gadget: Qualcomm DWC3 & PHYs built-in for early USB gadget / dropbear SSH
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# Display & GPU (Adreno 650 + MDSS DPU1)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y

# Input: Volume keys and touch
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_TOUCHSCREEN_FTS5CU56A=y
CONFIG_I2C_QCOM_GENI=y

# RAM Optimization: Multi-comp zram + MGLRU
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
