# SPDX-License-Identifier: MIT
# Samsung Galaxy S20 FE (r8q / SM8250) kernel config fragment.
# Merged on top of arm64 defconfig and omamobile.config.

# Qualcomm SM8250 SoC essentials
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_QCOM_GPI_DMA=y

# Interconnect & CPU DVFS (built-in for early frequency scaling)
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# Storage: Qualcomm UFS & Filesystems
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# USB & Gadget: Qualcomm DWC3 & PHYs built-in for early USB gadget / dropbear SSH
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# Display & GPU (Adreno 650 + MDSS DPU1). Keep MSM a module for now: the
# panel is driven by simpledrm on the bootloader's live DSI scanout, so msm is
# not needed for the console, and a module keeps the boot image small. It must
# be installed (bin/omamobile modules) before the GPU render node appears.
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y

# Power management: this port cannot suspend yet.
#
# s2idle on r8q never comes back: entering it freezes userspace (sshd answers
# TCP but never sends its banner) and the phone is wedged until a PMIC hard
# reset. Masking the sleep targets in userspace was not enough, so build
# suspend out of the kernel: logind then reports "Sleep not supported" and no
# caller can reach the freezer. Re-enable CONFIG_SUSPEND once a suspend test
# has woken on the power key (device/r8q/PORT-PLAN.md, suspend section).
# CONFIG_SUSPEND is not set

# Watchdogs: qcom-wdt is the APSS watchdog and softdog is the fallback. With
# systemd's RuntimeWatchdogSec (packages/omamobile-device-r8q) a wedged
# userspace reboots the phone by itself instead of needing a hard reset.
CONFIG_QCOM_WDT=y
CONFIG_SOFT_WATCHDOG=y

# kexec with a device tree: ram-only boots of a rebuilt kernel, for bring-up
# that must not flash sda24 (CAMERA-PLAN.md). kexec_file_load works without
# this, but it re-generates the DT from the running one and ignores --dtb;
# the load syscall honours --dtb and needs /proc/kcore for VA_BITS, which
# CONFIG_PROC_KCORE provides. Both syscalls are already in arm64 defconfig.
CONFIG_PROC_KCORE=y

# The RCU stall detector (on by default) is the only thing that has caught
# the wedged-core crashes so far, and it only reports: a CPU stuck with
# interrupts off (e.g. spinning on a lock held by a wedged core) used to
# take the phone down with it silently. The softlockup detector turns a
# 10 s atomic spin into a panic, and the cmdline (tools/r8q-boot) adds
# softlockup_panic=1 so the panic=10 timer reboots the phone by itself.
#
# Its limit, measured on the phone: it needs the scheduler tick, so it
# sees a CPU that spins with interrupts on, and nothing at all on one
# that spins with interrupts off. This config has no hard-lockup detector
# (CONFIG_ARM64_PSEUDO_NMI is not set, so neither is
# CONFIG_HARDLOCKUP_DETECTOR), which is why the rpmh-rsc lock leak of
# 2026-11-14 froze the phone at 0.63 s of boot with no output whatsoever.
# Enabling the pseudo-NMI watchdog is the follow-up, one boot at a time.
# The power-side hang with no ticks at all is covered from userspace by
# the per-CPU liveness net in the device package instead.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_ARM64_PSEUDO_NMI=y
CONFIG_HARDLOCKUP_DETECTOR=y

# Input: Volume keys and touch
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_I2C_QCOM_GENI=y

# Camera: the SM8250 mainline V4L2 stack is CAMCC (camera clock controller,
# MCLK and the CAMSS power domains) -> CAMSS (CSIPHY/CSID/VFE, the ISP that
# creates /dev/video*) with the sensor on a QUP I2C bus. All modules, so a
# failure to probe cannot stop the boot; the CAMSS and sensor device-tree
# nodes stay disabled in the base DTB and are enabled by the camera.dtso
# overlay one boot at a time (device/r8q/CAMERA-PLAN.md).
#
# The rear telephoto (SK Hynix HI-847) is the first camera because it is the
# only sensor on this board with an in-tree register-level driver.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L2_FWNODE=m
CONFIG_V4L2_ASYNC=m
CONFIG_SM_CAMCC_8250=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_HI847=m
CONFIG_VIDEO_S5K3L6XX=m
CONFIG_MHI_BUS_DEBUG=y

# Power key: qcom-pon populates the PMIC's pwrkey/resin children. It must be
# built in, not a module: it is what creates the power-key input device and
# its wake source, so without it the power button does nothing and a
# suspended phone cannot be woken (the s2idle freeze on this port).
CONFIG_POWER_RESET_QCOM_PON=y

# Battery & Companion PMIC: Maxim MAX77705
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX17042=m
CONFIG_LEDS_MAX77705=m
CONFIG_SENSORS_MAX77705=m

# RAM Optimization: Multi-comp zram + MGLRU
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_SND_SOC_CS35L41=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# Modem MSI (MODEM-PLAN §9): the qcom,pci-msi doorbell for PCIe2, built in
# so the controller exists before the PCI host probes.
CONFIG_QCOM_PCI_MSI=y
