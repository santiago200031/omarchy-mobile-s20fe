# SPDX-License-Identifier: MIT
# Samsung Galaxy S20 FE (r8q / SM8250) kernel config fragment.
# Merged on top of arm64 defconfig and omamobile.config.

# Qualcomm SM8250 SoC essentials
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_QCOM_GPI_DMA=y

# Interconnect & CPU DVFS (built-in for early frequency scaling)
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# Storage: Qualcomm UFS & Filesystems
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y

# USB & Gadget: Qualcomm DWC3 & PHYs built-in for early USB gadget / dropbear SSH
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# Display & GPU (Adreno 650 + MDSS DPU1). Keep MSM a module for now: the
# panel is driven by simpledrm on the bootloader's live DSI scanout, so msm is
# not needed for the console, and a module keeps the boot image small. It must
# be installed (bin/omamobile modules) before the GPU render node appears.
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y

# Power management: this port cannot suspend yet.
#
# s2idle on r8q never comes back: entering it freezes userspace (sshd answers
# TCP but never sends its banner) and the phone is wedged until a PMIC hard
# reset. Masking the sleep targets in userspace was not enough, so build
# suspend out of the kernel: logind then reports "Sleep not supported" and no
# caller can reach the freezer. Re-enable CONFIG_SUSPEND once a suspend test
# has woken on the power key (device/r8q/PORT-PLAN.md, suspend section).
# CONFIG_SUSPEND is not set

# Watchdogs: qcom-wdt is the APSS watchdog and softdog is the fallback. With
# systemd's RuntimeWatchdogSec (packages/omamobile-device-r8q) a wedged
# userspace reboots the phone by itself instead of needing a hard reset.
CONFIG_QCOM_WDT=y
CONFIG_SOFT_WATCHDOG=y

# Input: Volume keys and touch
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_TOUCHSCREEN_FTS5CU56A=y
CONFIG_I2C_QCOM_GENI=y

# Power key: qcom-pon populates the PMIC's pwrkey/resin children. It must be
# built in, not a module: it is what creates the power-key input device and
# its wake source, so without it the power button does nothing and a
# suspended phone cannot be woken (the s2idle freeze on this port).
CONFIG_POWER_RESET_QCOM_PON=y

# Battery & Companion PMIC: Maxim MAX77705
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX17042=m
CONFIG_LEDS_MAX77705=m
CONFIG_SENSORS_MAX77705=m

# RAM Optimization: Multi-comp zram + MGLRU
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_SND_SOC_CS35L41=m
CONFIG_SND_SOC_CS35L41_I2C=m
