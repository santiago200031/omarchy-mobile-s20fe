// SPDX-License-Identifier: MIT
/*
 * Bring-up overlay (PORT-PLAN M7): enable gpi_dma1 (ee_offset 0x6000) and
 * i2c11 for isolated CS35L41 smart-amp I2C probing at 0x40 / 0x41.
 */
/dts-v1/;
/plugin/;

&{/soc@0/dma-controller@a00000} {
	status = "okay";
};

&{/soc@0/geniqup@ac0000/i2c@a8c000} {
	status = "okay";
};
