[Unit]
Description=Omarchy Mobile AI supervisor
After=network.target
Requires=network.target

[Service]
Type=simple
ExecStart=/usr/bin/omamobile-ai
Restart=on-failure
RestartSec=5
Environment=OMAMOBILE_AI_CONFIG=/etc/omamobile-ai.conf

[Install]
WantedBy=multi-user.target
