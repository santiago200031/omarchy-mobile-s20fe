# SPDX-License-Identifier: MIT
# The initramfs brings up the CDC NCM gadget. This gives usb0 an address
# after switch_root. The laptop is 172.16.42.2.
#
# Wi-Fi (metric 600) and mobile data (metric 700) must beat the USB gadget
# route so traffic goes out over Wi-Fi/cellular whenever available, and
# ConfigureWithoutCarrier keeps usb0 from claiming the default route on unplug.
[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DNS=1.1.1.1
DNS=9.9.9.9
ConfigureWithoutCarrier=yes

[Route]
Gateway=172.16.42.2
Metric=2000
