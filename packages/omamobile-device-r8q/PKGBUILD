# SPDX-License-Identifier: MIT
# Maintainer: Santiago <santiago@omamobile.local>
pkgname=omamobile-device-r8q
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile support for Samsung Galaxy S20 FE (r8q): reboot-to and USB networking"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash systemd)

build() {
  # Same syscall as device/r8q/initramfs/reboot-to.c. No libc.
  gcc -nostdlib -static -ffreestanding -fno-stack-protector \
    -fno-asynchronous-unwind-tables -Oz \
    -o "$srcdir/reboot-to" "$startdir/reboot-to.c"

  # Build Rust native on-device AI server
  if command -v cargo >/dev/null 2>&1; then
    cargo build --manifest-path "$startdir/rust/ai-server/Cargo.toml" --release --target-dir "$srcdir/cargo-target"
    cp "$srcdir/cargo-target/release/ai-server" "$srcdir/omamobile-ai-server"
  fi
}

package() {
  install -Dm755 "$srcdir/reboot-to" "$pkgdir/usr/local/bin/reboot-to"
  install -Dm755 "$startdir/reboot" "$pkgdir/usr/local/bin/reboot"
  if [[ -f "$srcdir/omamobile-ai-server" ]]; then
    install -Dm755 "$srcdir/omamobile-ai-server" "$pkgdir/usr/local/bin/omamobile-ai-server"
  else
    install -Dm755 "$startdir/omamobile-ai-server.py" "$pkgdir/usr/local/bin/omamobile-ai-server"
  fi
  install -Dm644 "$startdir/20-usb-gadget.network" \
    "$pkgdir/usr/lib/systemd/network/20-usb-gadget.network"
  install -Dm644 "$startdir/10-omamobile-usb.conf" \
    "$pkgdir/usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf"
  install -Dm644 "$startdir/sshd-omamobile.conf" \
    "$pkgdir/etc/ssh/sshd_config.d/omamobile.conf"
  install -Dm644 "$startdir/sshd.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/sshd.conf"
  # The console prompt has no keyboard on this phone, and it is
  # Before=sysinit, so it holds the boot ahead of sshd.
  install -d "$pkgdir/etc/systemd/system"
  ln -s /dev/null "$pkgdir/etc/systemd/system/systemd-firstboot.service"
  install -Dm644 "$startdir/omamobile-mirrorlist" \
    "$pkgdir/etc/pacman.d/omamobile-mirrorlist"
  install -Dm644 "$startdir/90-r8q-vm.conf" \
    "$pkgdir/usr/lib/sysctl.d/90-r8q-vm.conf"
  install -Dm644 "$startdir/91-r8q-zram.conf" \
    "$pkgdir/usr/lib/systemd/zram-generator.conf.d/91-r8q-zram.conf"
  install -Dm644 "$startdir/80-r8q-mglru.conf" \
    "$pkgdir/usr/lib/tmpfiles.d/80-r8q-mglru.conf"
  install -Dm644 "$startdir/80-r8q-gpu.rules" \
    "$pkgdir/usr/lib/udev/rules.d/80-r8q-gpu.rules"
  install -Dm644 "$startdir/hyprland-r8q.conf" \
    "$pkgdir/usr/share/omamobile/hypr/r8q.conf"
  # Suspend never wakes on this port: logind refuses it, the seat never idles
  # into it, and the targets are masked for anything that calls them directly
  # (README-suspend.md). The kernel command line masks them too, so even a
  # broken userspace cannot reach the freezer.
  install -Dm644 "$startdir/10-r8q-no-suspend.conf" \
    "$pkgdir/usr/lib/systemd/sleep.conf.d/10-r8q-no-suspend.conf"
  install -Dm644 "$startdir/10-r8q-no-idle.conf" \
    "$pkgdir/usr/lib/systemd/logind.conf.d/10-r8q-no-idle.conf"
  install -Dm644 "$startdir/README-suspend.md" \
    "$pkgdir/usr/share/doc/$pkgname/README-suspend.md"
  # A wedged userspace reboots the phone instead of needing a hard reset.
  install -Dm644 "$startdir/10-r8q-watchdog.conf" \
    "$pkgdir/usr/lib/systemd/system.conf.d/10-r8q-watchdog.conf"
  # The UFS link must not auto-hibernate: a failed hibern8 exit wedges every
  # process that touches the disk (README-suspend.md, "UFS").
  install -Dm755 "$startdir/ufs-no-autohibern8" \
    "$pkgdir/usr/lib/omamobile/ufs-no-autohibern8"
  install -Dm644 "$startdir/omamobile-r8q-ufs.service" \
    "$pkgdir/usr/lib/systemd/system/omamobile-r8q-ufs.service"
  # fbcon blanks the console after 10 minutes and the panel stays black: keep
  # it unblanked (see the service for why the timer repeats it).
  install -Dm644 "$startdir/omamobile-r8q-panel.service" \
    "$pkgdir/usr/lib/systemd/system/omamobile-r8q-panel.service"
  install -Dm644 "$startdir/omamobile-r8q-panel.timer" \
    "$pkgdir/usr/lib/systemd/system/omamobile-r8q-panel.timer"
  install -d "$pkgdir/etc/systemd/system"
  for target in sleep suspend hibernate hybrid-sleep suspend-then-hibernate; do
    ln -s /dev/null "$pkgdir/etc/systemd/system/$target.target"
  done
  install -Dm644 "$startdir/ucm2/conf.d/kona-mtp-snd-card/kona-mtp-snd-card.conf" \
    "$pkgdir/usr/share/alsa/ucm2/conf.d/kona-mtp-snd-card/kona-mtp-snd-card.conf"
  install -Dm644 "$startdir/ucm2/Samsung/r8q/HiFi.conf" \
    "$pkgdir/usr/share/alsa/ucm2/Samsung/r8q/HiFi.conf"
  install -Dm644 "$startdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Enable sshd, networkd and a rescue shell on the USB serial port (ttyGS0).
  # The serial getty is the way in when the USB network stack or the session is
  # wedged; the kernel console is on the same port (console=ttyGS0).
  local wants="$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  install -d "$wants"
  ln -s ../systemd-networkd.service "$wants/systemd-networkd.service"
  ln -s ../sshd.service "$wants/sshd.service"
  ln -s ../serial-getty@.service "$wants/serial-getty@ttyGS0.service"
  ln -s ../omamobile-r8q-ufs.service "$wants/omamobile-r8q-ufs.service"
  ln -s ../omamobile-r8q-panel.timer "$wants/omamobile-r8q-panel.timer"
}
