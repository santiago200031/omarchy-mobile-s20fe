# SPDX-License-Identifier: MIT
# Clean up older /etc overrides shadowed over /usr/lib/systemd/network/20-usb-gadget.network
# and remind operators about r8q-preflight before unblacklisting msm.

_cleanup_stale_usb_network() {
  local etc_net="/etc/systemd/network/20-usb-gadget.network"
  if [[ -f $etc_net ]] && grep -q 'Metric=900' "$etc_net" 2>/dev/null; then
    rm -f "$etc_net"
  fi
}

post_install() {
  _cleanup_stale_usb_network
  rm -f /etc/systemd/system/multi-user.target.wants/omamobile-r8q-rtc.service
  if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
    systemctl daemon-reload || true
  fi
}

post_upgrade() {
  post_install
}
