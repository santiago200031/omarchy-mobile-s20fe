#!/bin/sh
# SPDX-License-Identifier: MIT
# omamobile-r8q-liveness-monitor: reboot the phone when a core stops living.
#
# The RPMh/RCU crash class on this phone (device/r8q/PORT-PLAN.md blocker 1)
# wedges a single core -- most often in a bus-level hang where the core
# never ticks again and no kernel detector can fire on it. The kernel
# watchdogs and the softlockup detector only see spinning cores; a core
# stuck in an unreachable register read stops publishing ticks entirely.
#
# This monitor runs one SCHED_FIFO heartbeat per online CPU (r8q-liveness-
# heartbeat) and watches their monotonic timestamps. An online core whose
# heartbeat is stale for STALE_NS is wedged: the monitor crashes the kernel
# (sysrq c -> panic -> panic=10 -> PSCI reset from a live core), falling
# back to the package's reboot-to (LINUX_REBOOT_CMD_RESTART2) when sysrq is
# unavailable. The pstore console of the crashed boot survives the reset.
#
# --check-only judges heartbeats without spawning its own and without
# rebooting (it prints "stale <cpu>" and exits): used by the package test
# with a fake sysfs tree.
#
# Environment (tests):
#   R8Q_LIVENESS_SYS     sysfs root          (default /sys)
#   R8Q_LIVENESS_RUN     heartbeat dir       (default /run/omamobile-liveness)
#   R8Q_LIVENESS_STALE_NS   staleness threshold (default 10 s)
#   R8Q_LIVENESS_HEARTBEAT  heartbeat binary  (default /usr/lib/omamobile/...)
set -u

SYS=${R8Q_LIVENESS_SYS:-/sys}
RUN=${R8Q_LIVENESS_RUN:-/run/omamobile-liveness}
STALE_NS=${R8Q_LIVENESS_STALE_NS:-10000000000}
HEARTBEAT=${R8Q_LIVENESS_HEARTBEAT:-/usr/lib/omamobile/r8q-liveness-heartbeat}
CHECK_ONLY=0
[ "${1:-}" = "--check-only" ] && CHECK_ONLY=1

PIDDIR="$RUN/pids"

log() {
    printf 'r8q-liveness: %s\n' "$*"
    [ -w /dev/kmsg ] && printf 'r8q-liveness: %s\n' "$*" > /dev/kmsg
}

now_ns() {
    # /proc/uptime (seconds since boot) is the same clock the heartbeats
    # use (CLOCK_MONOTONIC). 0.01 s resolution, 10 s threshold: plenty.
    awk '{ printf "%.0f", $1 * 1000000000 }' /proc/uptime
}

online_cpus() {
    # The cpuN sysfs dirs exist for possible CPUs; "1" in online means up.
    for d in "$SYS/devices/system/cpu"/cpu[0-9]*; do
        [ -d "$d" ] || continue
        [ "$(cat "$d/online" 2>/dev/null)" = "1" ] || continue
        printf '%s\n' "${d##*/cpu}"
    done
}

start_heartbeats() {
    for c in $(online_cpus); do
        f="$PIDDIR/$c"
        [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && continue
        "$HEARTBEAT" "$c" "$RUN" &
        echo $! > "$f"
    done
    # Drop heartbeats of CPUs that went offline.
    for p in "$PIDDIR"/*; do
        [ -f "$p" ] || continue
        c=${p##*/}
        [ "$(cat "$SYS/devices/system/cpu/cpu$c/online" 2>/dev/null)" = "1" ] || { kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; }
    done
}

stale_cpus() {
    now=$(now_ns)
    for c in $(online_cpus); do
        # Last line only: the heartbeat rewrites offset 0 every second, so
        # the file holds one line, but an older or hand-made file may hold
        # several and awk would silently use the oldest.
        ts=$(tail -n 1 "$RUN/cpu$c" 2>/dev/null) || continue
        [ -n "$ts" ] || continue
        awk -v n="$now" -v t="$ts" -v s="$STALE_NS" \
            'BEGIN { exit !(n - t > s) }' && printf '%s\n' "$c"
    done
}

reboot_phone() {
    log "rebooting: crashing the kernel (sysrq c, then reboot-to)"
    echo c > /proc/sysrq-trigger 2>/dev/null
    sleep 30
    # Still alive (sysrq unavailable or refused): raw PSCI reset syscall.
    /usr/local/bin/reboot-to 2>/dev/null
    # Should never be reached: keep the unit alive until the reset lands.
    while :; do sleep 30; done
}

offline_unreserved_xpu_pages() {
    ctl="$SYS/devices/system/memory/hard_offline_page"
    [ "$SYS" = "/sys" ] && [ -w "$ctl" ] && [ -r /proc/iomem ] || return 0
    # Safety fallback when booting a DT that omits Samsung XPU/TZ/Knox no-map
    # nodes: keep buddy/DMA allocators off firmware-protected physical pages.
    grep -Eq '(90500000-|9e300000-|9fb00000-bcbfffff) .*System RAM' /proc/iomem || return 0
    [ "$(awk '/^HardwareCorrupted:/ { print $2 }' /proc/meminfo)" -lt 23520 ] || return 0
    for range in \
        0x80603000:0x80700000 \
        0x80880000:0x80894000 \
        0x85e00000:0x86200000 \
        0x8681a000:0x86900000 \
        0x90500000:0x90a00000 \
        0x9e300000:0x9e400000 \
        0x9f000000:0x9f800000 \
        0x9f800000:0x9fa00000 \
        0xa0001000:0xa0002000 \
        0xb0100000:0xb0200000
    do
        addr=$((${range%:*}))
        end=$((${range#*:}))
        while [ "$addr" -lt "$end" ]; do
            printf '0x%x\n' "$addr" > "$ctl" 2>/dev/null || true
            addr=$((addr + 4096))
        done
    done
    log "offlined unreserved XPU/TZ/Knox pages via hard_offline_page"
}

pin_r8q_power_control() {
    [ "$SYS" = "/sys" ] || return 0
    for ctl in \
        "$SYS/devices/platform/soc@0/3d00000.gpu/power/control" \
        "$SYS/devices/platform/soc@0/3d6a000.gmu/power/control" \
        "$SYS/devices/platform/soc@0/9c0000.geniqup/power/control" \
        "$SYS/devices/platform/soc@0/9c0000.geniqup/980000.i2c/power/control" \
        "$SYS/devices/platform/soc@0/9c0000.geniqup/994000.i2c/power/control" \
        "$SYS/bus/i2c/devices/5-0049/power/control"
    do
        [ -w "$ctl" ] || continue
        state=""
        read -r state < "$ctl" 2>/dev/null || true
        [ "$state" = "on" ] || echo on > "$ctl" 2>/dev/null || true
    done
}

ensure_r8q_touch_driver() {
    [ "$SYS" = "/sys" ] || return 0
    kver=$(uname -r 2>/dev/null) || return 0
    ko="/usr/lib/modules/$kver/extra/stmfts-r8q.ko"
    dev="$SYS/bus/i2c/devices/5-0049"
    [ -f "$ko" ] && [ -d "$dev" ] || return 0
    cur=""
    if [ -L "$dev/driver" ]; then
        cur=$(basename "$(readlink "$dev/driver" 2>/dev/null)" 2>/dev/null) || cur=""
    fi
    [ "$cur" = "stmfts-r8q" ] && return 0
    if [ ! -d "$SYS/bus/i2c/drivers/stmfts-r8q" ]; then
        insmod "$ko" 2>/dev/null || modprobe stmfts-r8q 2>/dev/null || return 0
    fi
    if [ "$cur" = "stmfts" ] && [ -w "$SYS/bus/i2c/drivers/stmfts/unbind" ]; then
        echo 5-0049 > "$SYS/bus/i2c/drivers/stmfts/unbind" 2>/dev/null || true
    fi
    if [ -w "$SYS/bus/i2c/drivers/stmfts-r8q/bind" ] && [ ! -e "$dev/driver" ]; then
        echo 5-0049 > "$SYS/bus/i2c/drivers/stmfts-r8q/bind" 2>/dev/null || true
    fi
    log "rebound 5-0049 from ${cur:-unbound} to stmfts-r8q"
}

main() {
    mkdir -p "$RUN" "$PIDDIR"
    if ((CHECK_ONLY)); then
        log "check-only: judging existing heartbeats, no heartbeats spawned"
    else
        offline_unreserved_xpu_pages
        pin_r8q_power_control
        ensure_r8q_touch_driver
        start_heartbeats
        # Give the heartbeats their first tick before judging anything.
        sleep 5
    fi

    while :; do
        stale=$(stale_cpus)
        if [ -n "$stale" ]; then
            # Confirm once more after 5 s: a load burst or a CPU coming
            # online must not cost a reboot. Newlines to spaces so the
            # membership test below cannot miss on a multi-CPU list.
            sleep 5
            stale2=$(stale_cpus | tr '\n' ' ')
            for c in $stale; do
                case " $stale2 " in
                    *" $c "*)
                        log "CPU $c online but its heartbeat is stale: core wedged"
                        if ((CHECK_ONLY)); then
                            printf 'stale %s\n' "$c"
                            exit 0
                        fi
                        reboot_phone
                        ;;
                esac
            done
        fi
        if ((CHECK_ONLY)); then
            sleep 1
            continue
        fi
        pin_r8q_power_control
        start_heartbeats
        sleep 2
    done
}

main "$@"
