#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
cmp reboot-to.c ../../device/r8q/initramfs/reboot-to.c
cmp reboot ../../device/r8q/reboot
sh -n reboot
grep -q "vm.swappiness = 150" 90-r8q-vm.conf
grep -q "zram-size = ram / 2" 91-r8q-zram.conf
grep -q "min_ttl_ms" 80-r8q-mglru.conf
grep -q "simple_ondemand" 80-r8q-gpu.rules
grep -q "mobileSpring" hyprland-r8q.conf
test -f ucm2/conf.d/kona-mtp-snd-card/kona-mtp-snd-card.conf
test -f ucm2/Samsung/r8q/HiFi.conf
# Suspend never wakes on this port: the gate, the seat and the masks ship.
grep -qx 'AllowSuspend=no' 10-r8q-no-suspend.conf
grep -qx 'AllowHibernation=no' 10-r8q-no-suspend.conf
grep -qx 'IdleAction=ignore' 10-r8q-no-idle.conf
grep -q 'suspend-then-hibernate' PKGBUILD
grep -q 'serial-getty@ttyGS0' PKGBUILD
grep -qx 'RuntimeWatchdogSec=30s' 10-r8q-watchdog.conf
grep -q 'auto_hibern8' ufs-no-autohibern8
grep -q 'auto_hibern8' omamobile-r8q-ufs.service
echo ok config
echo ok wrapper
echo ok sources
