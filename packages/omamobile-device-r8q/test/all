#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
cmp reboot-to.c ../../device/r8q/initramfs/reboot-to.c
cmp reboot ../../device/r8q/reboot
sh -n reboot
grep -q "vm.swappiness = 150" 90-r8q-vm.conf
grep -q "vm.dirty_background_bytes = 16777216" 90-r8q-vm.conf
grep -q "vm.dirty_bytes = 67108864" 90-r8q-vm.conf
grep -q "backup=(etc/pacman.d/omamobile-mirrorlist)" PKGBUILD
grep -q "zram-size = ram / 2" 91-r8q-zram.conf
grep -q "min_ttl_ms" 80-r8q-mglru.conf
grep -q "simple_ondemand" 80-r8q-gpu.rules
grep -q 'max_freq.*305000000' 80-r8q-gpu.rules
grep -q "enabled = false" hyprland-r8q.conf
test -f ucm2/conf.d/kona-mtp-snd-card/kona-mtp-snd-card.conf
test -f ucm2/Samsung/r8q/HiFi.conf
# Suspend never wakes on this port: the gate, the seat and the masks ship.
grep -qx 'AllowSuspend=no' 10-r8q-no-suspend.conf
grep -qx 'AllowHibernation=no' 10-r8q-no-suspend.conf
grep -qx 'IdleAction=ignore' 10-r8q-no-idle.conf
grep -q 'suspend-then-hibernate' PKGBUILD
grep -q 'serial-getty@ttyGS0' PKGBUILD
grep -qx 'RuntimeWatchdogSec=30s' 10-r8q-watchdog.conf
! grep -qx 'blacklist msm' 50-r8q-gpu-blacklist.conf
grep -q 'auto_hibern8' ufs-no-autohibern8
grep -q 'clkscale_enable' ufs-no-autohibern8
grep -q 'clkgate_enable' ufs-no-autohibern8
grep -q 'auto_hibern8' omamobile-r8q-ufs.service
test -x cpuidle-no-deep-sleep
grep -q '!= WFI' cpuidle-no-deep-sleep
grep -q 'cpuidle-no-deep-sleep' omamobile-r8q-cpuidle.service
test -x cpufreq-no-dvfs
grep -q 'scaling_governor' cpufreq-no-dvfs
grep -q 'cpufreq-no-dvfs' omamobile-r8q-cpuidle.service
grep -q 'cpufreq-no-dvfs' PKGBUILD
grep -q 'omamobile-r8q-cpuidle.service' PKGBUILD
test -x r8q-rtc-epoch
sh -n r8q-rtc-epoch
! ./r8q-rtc-epoch bogus 2>/dev/null
test -x r8q-wifi-aspm
sh -n r8q-wifi-aspm
grep -q 'l0s_aspm' r8q-wifi-aspm
grep -q 'r8q-wifi-aspm' omamobile-r8q-wifi.service
grep -q 'omamobile-r8q-wifi.service' PKGBUILD
grep -q 'r8q-rtc-epoch restore' omamobile-r8q-rtc.service
grep -q 'r8q-rtc-epoch save' omamobile-r8q-rtc.service
grep -q 'WantedBy=sysinit.target' omamobile-r8q-rtc.service
grep -q 'DefaultDependencies=no' omamobile-r8q-rtc.service
grep -q 'sysinit.target.wants' PKGBUILD
grep -q 'sysinit_wants/omamobile-r8q-rtc.service' PKGBUILD
grep -q 'omamobile-r8q-rtc.service' PKGBUILD
grep -q '18081' rust/ai-server/src/main.rs
grep -q 'max170xx_battery' rust/ai-server/src/main.rs
grep -q 'max77705-charger' rust/ai-server/src/main.rs
grep -q '/sys/class/graphics/fb0/blank' omamobile-r8q-panel.service
grep -qx 'OnUnitActiveSec=4min' omamobile-r8q-panel.timer
# Liveness net: a wedged core stops ticking and no kernel detector can fire
# on it (the r8q crash class); the monitor must ship with its unit, the
# heartbeat must be FIFO on the pinned CPU, and the decision logic must
# flag exactly the stale online CPU.
sh -n r8q-liveness-monitor
test -f r8q-liveness-heartbeat.c
grep -q 'SCHED_FIFO' r8q-liveness-heartbeat.c
grep -q 'CLOCK_MONOTONIC' r8q-liveness-heartbeat.c
grep -q 'sched_getcpu' r8q-liveness-heartbeat.c
grep -q 'sysrq-trigger' r8q-liveness-monitor
grep -q 'reboot-to' r8q-liveness-monitor
grep -q 'omamobile-r8q-liveness.service' PKGBUILD
grep -q 'Restart=always' omamobile-r8q-liveness.service
sys=$(mktemp -d) run=$(mktemp -d)
trap 'rm -rf "$sys" "$run"' EXIT
for c in 0 1; do
  mkdir -p "$sys/devices/system/cpu/cpu$c"
  echo 1 > "$sys/devices/system/cpu/cpu$c/online"
done
# Case A: both heartbeats fresh -> no "stale" output (timeout kills it).
awk '{ printf "%.0f", $1 * 1000000000 }' /proc/uptime > "$run/cpu0"
cp "$run/cpu0" "$run/cpu1"
out=$(R8Q_LIVENESS_SYS="$sys" R8Q_LIVENESS_RUN="$run" \
  R8Q_LIVENESS_STALE_NS=10000000000 \
  timeout 8 ./r8q-liveness-monitor --check-only 2>&1) || true
! printf '%s' "$out" | grep -q 'stale'
# Case B: cpu1 one hour stale -> "stale 1" and only that. Refresh cpu0
# right before the run: case A's timeout has already elapsed, and on a
# slow machine its timestamp would itself be past the 10 s threshold.
awk '{ printf "%.0f", $1 * 1000000000 }' /proc/uptime > "$run/cpu0"
awk '{ printf "%.0f", ($1 - 3600) * 1000000000 }' /proc/uptime > "$run/cpu1"
out=$(R8Q_LIVENESS_SYS="$sys" R8Q_LIVENESS_RUN="$run" \
  R8Q_LIVENESS_STALE_NS=10000000000 \
  timeout 60 ./r8q-liveness-monitor --check-only 2>&1) || true
printf '%s' "$out" | grep -q 'stale 1'
! printf '%s' "$out" | grep -q 'stale 0'
# Case C: an appended heartbeat file with a stale FIRST line and a fresh
# LAST line must not fire. The heartbeat once opened its file with "w" and
# never seeked back, so it appended: the monitor then compared the oldest
# timestamp and would have rebooted a healthy phone every 15 s.
awk '{ printf "%.0f", $1 * 1000000000 }' /proc/uptime > "$run/cpu0"
awk '{ printf "%.0f\n", ($1 - 3600) * 1000000000 }' /proc/uptime > "$run/cpu1"
awk '{ printf "%.0f\n", $1 * 1000000000 }' /proc/uptime >> "$run/cpu1"
out=$(R8Q_LIVENESS_SYS="$sys" R8Q_LIVENESS_RUN="$run" \
  R8Q_LIVENESS_STALE_NS=10000000000 \
  timeout 8 ./r8q-liveness-monitor --check-only 2>&1) || true
! printf '%s' "$out" | grep -q 'stale'
rm -rf "$sys" "$run"
# Battery & charger (M6.1): the modular MAX77705/MAX17042 stack loads
# after early boot and its unit ships enabled.
sh -n r8q-battery-modprobe
grep -q 'max77705_charger' r8q-battery-modprobe
grep -q 'max17042_battery' r8q-battery-modprobe
grep -q 'omamobile-r8q-battery.service' PKGBUILD
# Networking, mirrorlist, GPU udev, UCM2, panel-unblank guard, and Rust r8q-preflight (0.1.14)
grep -q 'Metric=2000' 20-usb-gadget.network
grep -q 'DNS=9.9.9.9' 20-usb-gadget.network
grep -q 'https://pkgs.omamobile.org/stable/\$arch' omamobile-mirrorlist
grep -q 'KERNEL=="3d00000.gpu"' 80-r8q-gpu.rules
grep -q '305000000' 80-r8q-gpu.rules
grep -q 'power/control.*on' 80-r8q-gpu.rules
grep -q 'KERNEL=="9c0000.geniqup"' 80-r8q-gpu.rules
grep -q 'KERNEL=="980000.i2c"' 80-r8q-gpu.rules
grep -q 'KERNEL=="994000.i2c"' 80-r8q-gpu.rules
grep -q 'KERNEL=="998000.serial"' 80-r8q-gpu.rules
grep -q 'KERNEL=="5-0049"' 80-r8q-gpu.rules
grep -q '1080x2400@60' hyprland-r8q.conf
! grep -q 'vfr' hyprland-r8q.conf
grep -q 'offline_unreserved_xpu_pages' r8q-liveness-monitor
grep -q 'pin_r8q_power_control' r8q-liveness-monitor
grep -q 'ensure_r8q_clock' r8q-liveness-monitor
grep -q 'ensure_r8q_touch_driver' r8q-liveness-monitor
grep -q 'ensure_r8q_bt_uart' r8q-liveness-monitor
grep -q 'ensure_r8q_desktop' r8q-liveness-monitor
grep -q '/sys/class/backlight' omamobile-r8q-panel.service
test -f omamobile-device-r8q.install
grep -q 'Samsung-Galaxy-S20-FE.conf' PKGBUILD
test -f ucm2/conf.d/sm8250/Samsung-Galaxy-S20-FE.conf
grep -q 'r8q-preflight' PKGBUILD
if command -v cargo >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/cargo" ]; then
  PATH="$HOME/.cargo/bin:$PATH" cargo test --manifest-path rust/r8q-preflight/Cargo.toml --quiet
fi
echo ok config
echo ok wrapper
echo ok sources
echo ok liveness
echo ok battery
echo ok preflight
