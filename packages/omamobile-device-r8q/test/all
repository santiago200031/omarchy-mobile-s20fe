#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
cmp reboot-to.c ../../device/r8q/initramfs/reboot-to.c
cmp reboot ../../device/r8q/reboot
sh -n reboot
grep -q "vm.swappiness = 150" 90-r8q-vm.conf
grep -q "vm.dirty_background_bytes = 16777216" 90-r8q-vm.conf
grep -q "vm.dirty_bytes = 67108864" 90-r8q-vm.conf
grep -q "backup=(etc/pacman.d/omamobile-mirrorlist)" PKGBUILD
grep -q "zram-size = ram / 2" 91-r8q-zram.conf
grep -q "min_ttl_ms" 80-r8q-mglru.conf
grep -q "simple_ondemand" 80-r8q-gpu.rules
grep -q "enabled = false" hyprland-r8q.conf
test -f ucm2/conf.d/kona-mtp-snd-card/kona-mtp-snd-card.conf
test -f ucm2/Samsung/r8q/HiFi.conf
# Suspend never wakes on this port: the gate, the seat and the masks ship.
grep -qx 'AllowSuspend=no' 10-r8q-no-suspend.conf
grep -qx 'AllowHibernation=no' 10-r8q-no-suspend.conf
grep -qx 'IdleAction=ignore' 10-r8q-no-idle.conf
grep -q 'suspend-then-hibernate' PKGBUILD
grep -q 'serial-getty@ttyGS0' PKGBUILD
grep -qx 'RuntimeWatchdogSec=30s' 10-r8q-watchdog.conf
grep -qx 'blacklist msm' 50-r8q-gpu-blacklist.conf
grep -q 'auto_hibern8' ufs-no-autohibern8
grep -q 'clkscale_enable' ufs-no-autohibern8
grep -q 'clkgate_enable' ufs-no-autohibern8
grep -q 'auto_hibern8' omamobile-r8q-ufs.service
test -x cpuidle-no-deep-sleep
grep -q '!= WFI' cpuidle-no-deep-sleep
grep -q 'cpuidle-no-deep-sleep' omamobile-r8q-cpuidle.service
test -x cpufreq-no-dvfs
grep -q 'scaling_governor' cpufreq-no-dvfs
grep -q 'cpufreq-no-dvfs' omamobile-r8q-cpuidle.service
grep -q 'cpufreq-no-dvfs' PKGBUILD
grep -q 'omamobile-r8q-cpuidle.service' PKGBUILD
test -x r8q-rtc-epoch
sh -n r8q-rtc-epoch
! ./r8q-rtc-epoch bogus 2>/dev/null
test -x r8q-wifi-aspm
sh -n r8q-wifi-aspm
grep -q 'l0s_aspm' r8q-wifi-aspm
grep -q 'r8q-wifi-aspm' omamobile-r8q-wifi.service
grep -q 'omamobile-r8q-wifi.service' PKGBUILD
grep -q 'r8q-rtc-epoch restore' omamobile-r8q-rtc.service
grep -q 'r8q-rtc-epoch save' omamobile-r8q-rtc.service
grep -q 'omamobile-r8q-rtc.service' PKGBUILD
grep -q '18081' rust/ai-server/src/main.rs
grep -q 'max77705-charger' rust/ai-server/src/main.rs
grep -q '/sys/class/graphics/fb0/blank' omamobile-r8q-panel.service
grep -qx 'OnUnitActiveSec=4min' omamobile-r8q-panel.timer
echo ok config
echo ok wrapper
echo ok sources
