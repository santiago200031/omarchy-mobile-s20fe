#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline checks for the tqftpserv package.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
fails=0
fail() { echo "FAIL: $*" >&2; fails=$((fails + 1)); }
pass() { echo "ok: $*"; }

(
  # shellcheck disable=SC1091
  source ./PKGBUILD
  [[ $pkgname == tqftpserv ]] || exit 1
  [[ $pkgver == "$(tr -d ' \n' < version)" ]] || exit 2
  [[ ${#source[@]} == "${#sha256sums[@]}" ]] || exit 3
  for i in "${!sha256sums[@]}"; do
    [[ ${sha256sums[$i]} =~ ^([0-9a-f]{64}|SKIP)$ ]] || exit 4
    if [[ ${sha256sums[$i]} != SKIP && $i -gt 0 ]]; then
      [[ ${sha256sums[$i]} == "$(sha256sum "${source[$i]}" | cut -d' ' -f1)" ]] || exit 5
    fi
  done
  [[ ${source[0]} == *"linux-msm/tqftpserv/archive/refs/tags/v$pkgver.tar.gz" ]] || exit 6
) && pass "PKGBUILD pins the upstream tag tarball and vendored checksums" \
  || fail "PKGBUILD pin check failed (exit $?)"

grep -qE '^ExecStart=/usr/bin/tqftpserv' tqftpserv.service \
  && pass "unit starts /usr/bin/tqftpserv" \
  || fail "tqftpserv.service ExecStart is wrong"

grep -q '^StateDirectory=tqftpserv' tqftpserv.service \
  && pass "writes are confined to the tqftpserv state directory" \
  || fail "tqftpserv.service must set StateDirectory=tqftpserv"

test "$fails" -eq 0
