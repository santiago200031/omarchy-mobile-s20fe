#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# omamobile-ai: On-demand local LLM runner for Omarchy Mobile (Snapdragon 865 / r8q)
# Strictly on-demand: NEVER runs as a persistent startup daemon. Zero RAM/CPU when idle.
set -euo pipefail

MODEL_DIR="${OMAMOBILE_MODEL_DIR:-/home/alarm/models}"
CONFIG_DIR="${OMAMOBILE_AI_CONFIG:-/home/alarm/.config/omamobile-ai}"
BIN_DIR="/usr/local/bin"
DEFAULT_MODEL_FILE="${CONFIG_DIR}/default_model"
PID_FILE="/tmp/llama-server.pid"
WATCHER_PID_FILE="/tmp/llama-server-watcher.pid"
DEFAULT_TIMEOUT=120  # seconds of inactivity before automatic shutdown

say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

ensure_dirs() {
  mkdir -p "$MODEL_DIR" "$CONFIG_DIR"
}

get_default_model() {
  ensure_dirs
  if [[ -f "$DEFAULT_MODEL_FILE" ]] && [[ -s "$DEFAULT_MODEL_FILE" ]]; then
    cat "$DEFAULT_MODEL_FILE"
    return 0
  fi
  # Autodetect first .gguf model in MODEL_DIR
  local first
  first=$(find "$MODEL_DIR" -maxdepth 1 -name "*.gguf" 2>/dev/null | head -n1 || true)
  if [[ -n "$first" ]]; then
    basename "$first" > "$DEFAULT_MODEL_FILE"
    cat "$DEFAULT_MODEL_FILE"
    return 0
  fi
  echo ""
}

is_running() {
  pgrep -f "llama-server" >/dev/null 2>&1
}

get_server_pid() {
  pgrep -f "llama-server" | head -n1 || true
}

cmd_status() {
  local pid
  pid=$(get_server_pid)
  local def_model
  def_model=$(get_default_model)

  say "Omarchy Mobile Local AI Status:"
  echo "  Default model: ${def_model:-[None configured in $MODEL_DIR]}"
  echo "  Models directory: $MODEL_DIR"

  if [[ -n "$pid" ]]; then
    local rss_kb
    rss_kb=$(grep VmRSS /proc/"$pid"/status 2>/dev/null | awk '{print $2}' || echo "0")
    local rss_mb=$(( rss_kb / 1024 ))
    local cpu
    cpu=$(ps -p "$pid" -o %cpu= 2>/dev/null | tr -d ' ' || echo "0.0")
    ok "llama-server is ACTIVE (PID: $pid, RAM: ${rss_mb} MB, CPU: ${cpu}%)"
    echo "  Listening on: http://127.0.0.1:8080"
  else
    echo "  llama-server: INACTIVE (0% CPU, 0 MB RAM — strictly on-demand)"
  fi
}

cmd_models() {
  ensure_dirs
  say "Installed GGUF models in $MODEL_DIR:"
  local count=0
  local def_model
  def_model=$(get_default_model)

  shopt -s nullglob
  for f in "$MODEL_DIR"/*.gguf; do
    count=$(( count + 1 ))
    local fname
    fname=$(basename "$f")
    local sz
    sz=$(ls -lh "$f" | awk '{print $5}')
    local marker="  "
    [[ "$fname" == "$def_model" ]] && marker="* "
    printf "%s%s (%s)\n" "$marker" "$fname" "$sz"
  done
  shopt -u nullglob

  if [[ $count -eq 0 ]]; then
    warn "No .gguf models found in $MODEL_DIR."
    echo "  Place a quantized model (.gguf) into $MODEL_DIR or run:"
    echo "  omamobile-ai pull <url_or_hf_repo>"
  fi
}

cmd_select() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: omamobile-ai select <model_filename.gguf>"
  ensure_dirs

  if [[ ! -f "$MODEL_DIR/$target" ]]; then
    die "Model file '$MODEL_DIR/$target' does not exist."
  fi
  echo "$target" > "$DEFAULT_MODEL_FILE"
  ok "Selected default model: $target"
}

cmd_stop() {
  say "Stopping any running local AI processes..."
  local pid
  pid=$(get_server_pid)
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  pkill -f "llama-cli" 2>/dev/null || true
  pkill -f "omamobile-ai-watchdog" 2>/dev/null || true
  rm -f "$PID_FILE" "$WATCHER_PID_FILE"
  ok "Local AI stopped. All memory reclaimed (0% CPU, 0 MB RAM)."
}

cmd_install_runtime() {
  say "Installing Snapdragon-optimized llama.cpp runtime (no daemons)..."
  mkdir -p /tmp/llama-install
  cd /tmp/llama-install

  local url="https://github.com/ggml-org/llama.cpp/releases/download/b12292/llama-b12292-bin-linux-arm64-snapdragon.tar.gz"
  say "Downloading release tarball from GitHub..."
  curl -sLO "$url"

  say "Extracting binaries..."
  tar -xzf llama-*-bin-linux-arm64-snapdragon.tar.gz
  local extract_dir
  extract_dir=$(find . -maxdepth 1 -type d -name "llama-*" | head -n1)

  mkdir -p /usr/local/bin /usr/local/lib
  cp "$extract_dir"/bin/llama* /usr/local/bin/ || true
  cp -a "$extract_dir"/lib/* /usr/local/lib/ 2>/dev/null || true
  ldconfig 2>/dev/null || true

  rm -rf /tmp/llama-install
  ok "llama.cpp runtime installed to /usr/local/bin."
  ok "Startup services: NONE (strictly on-demand)."
}

# Pick online Kryo 585 performance cores (Gold 4-6 + Prime 7) so inference
# stays off Silver A55 cores (0-3) and leaves them for UI, IRQs and watchdogs.
_perf_cpu_list() {
  local cpus=() c
  for c in 4 5 6 7; do
    if [[ -r /sys/devices/system/cpu/cpu${c}/online ]]; then
      [[ $(<"/sys/devices/system/cpu/cpu${c}/online") == 1 ]] && cpus+=("$c")
    fi
  done
  if [[ ${#cpus[@]} -eq 0 ]]; then
    echo ""
    return 0
  fi
  local IFS=,
  echo "${cpus[*]}"
}

# Watchdog function to shut down server after idle timeout
_watchdog() {
  local timeout="$1"
  local idle_count=0

  while is_running; do
    sleep 5
    # Count only established TCP clients on :8080 (ignore LISTEN/TIME-WAIT)
    local conns
    conns=$(ss -Htn state established '( sport = :8080 )' 2>/dev/null | wc -l)
    if [[ "$conns" -gt 0 ]]; then
      idle_count=0
    else
      idle_count=$(( idle_count + 5 ))
    fi

    if [[ "$idle_count" -ge "$timeout" ]]; then
      # Idle timeout reached
      cmd_stop >/dev/null 2>&1
      exit 0
    fi
  done
}

cmd_serve() {
  local timeout="${1:-$DEFAULT_TIMEOUT}"
  local host="${OMAMOBILE_AI_HOST:-127.0.0.1}"
  local model_name
  model_name=$(get_default_model)
  [[ -n "$model_name" ]] || die "No model selected. Use 'omamobile-ai select <model.gguf>' first."
  local model_path="$MODEL_DIR/$model_name"
  [[ -f "$model_path" ]] || die "Model not found at $model_path"

  if is_running; then
    ok "llama-server is already running."
    return 0
  fi

  which llama-server >/dev/null 2>&1 || die "llama-server not found. Run 'omamobile-ai install-runtime' first."

  local perf_cpus threads=4
  local run_prefix=()
  perf_cpus=$(_perf_cpu_list)
  if [[ -n "$perf_cpus" ]] && command -v taskset >/dev/null 2>&1; then
    run_prefix=(taskset -c "$perf_cpus")
    threads=$(awk -F, '{print NF}' <<<"$perf_cpus")
  fi

  say "Starting on-demand llama-server with model $model_name (cores: ${perf_cpus:-auto}, threads: $threads, idle timeout: ${timeout}s)..."
  # SM8250 Kryo 585: pin to online A77 performance cores (Gold 4-6 + Prime 7)
  nohup "${run_prefix[@]}" llama-server \
    -m "$model_path" \
    --host "$host" \
    --port 8080 \
    -t "$threads" \
    -c 2048 \
    --timeout "$timeout" > /tmp/llama-server.log 2>&1 &
  local s_pid=$!
  echo "$s_pid" > "$PID_FILE"

  # Start idle watchdog in background
  ( _watchdog "$timeout" ) >/dev/null 2>&1 &
  echo $! > "$WATCHER_PID_FILE"

  say "Waiting for llama-server to initialize..."
  local attempts=0
  while [[ $attempts -lt 30 ]]; do
    if curl -s http://127.0.0.1:8080/health >/dev/null 2>&1; then
      ok "llama-server is ready on http://${host}:8080 (will terminate after ${timeout}s idle)"
      return 0
    fi
    sleep 1
    attempts=$(( attempts + 1 ))
  done

  warn "Server did not respond to /health in 30s. Check /tmp/llama-server.log"
}

cmd_ask() {
  local prompt="${*:-}"
  [[ -n "$prompt" ]] || die "Usage: omamobile-ai ask \"Your prompt here\""

  local model_name
  model_name=$(get_default_model)
  [[ -n "$model_name" ]] || die "No model selected. Use 'omamobile-ai select <model.gguf>' first."
  local model_path="$MODEL_DIR/$model_name"

  which llama-cli >/dev/null 2>&1 || which llama >/dev/null 2>&1 || die "llama-cli not found. Run 'omamobile-ai install-runtime' first."
  local bin="llama-cli"
  which llama-cli >/dev/null 2>&1 || bin="llama"

  local perf_cpus threads=4
  local run_prefix=()
  perf_cpus=$(_perf_cpu_list)
  if [[ -n "$perf_cpus" ]] && command -v taskset >/dev/null 2>&1; then
    run_prefix=(taskset -c "$perf_cpus")
    threads=$(awk -F, '{print NF}' <<<"$perf_cpus")
  fi

  say "Running one-shot CLI inference with $model_name (cores: ${perf_cpus:-auto}, threads: $threads)..."
  "${run_prefix[@]}" "$bin" \
    -m "$model_path" \
    -p "$prompt" \
    -t "$threads" \
    -c 2048 \
    --temp 0.7 \
    -n 256
  
  ok "Inference complete. RAM freed instantly."
}

cmd_chat() {
  local prompt="${*:-}"
  [[ -n "$prompt" ]] || die "Usage: omamobile-ai chat \"Your prompt here\""

  if ! is_running; then
    cmd_serve "$DEFAULT_TIMEOUT"
  fi

  local payload
  payload=$(python3 -c "import json, sys; print(json.dumps({'messages': [{'role': 'user', 'content': sys.argv[1]}], 'max_tokens': 256, 'temperature': 0.7}))" "$prompt")

  curl -s http://127.0.0.1:8080/v1/chat/completions \
    -H "Content-Type: application/json" \
    -d "$payload" | python3 -c "
import json, sys
try:
    res = json.load(sys.stdin)
    if 'choices' in res and len(res['choices']) > 0:
        print('\n' + res['choices'][0]['message']['content'].strip() + '\n')
    else:
        print(json.dumps(res, indent=2))
except Exception as e:
    print('Failed to parse response:', e)
"
}

usage() {
  cat <<'EOF'
omamobile-ai: On-demand local LLM runner for Omarchy Mobile (Snapdragon 865)

Strictly on-demand: Zero background daemons, zero idle RAM/CPU footprint.

Commands:
  status                     Show local AI state, RAM usage, and default model
  models                     List available GGUF models in /home/alarm/models
  select <model.gguf>        Set the default active model
  ask "<prompt>"             One-shot direct CLI inference (process exits immediately)
  chat "<prompt>"            Query against on-demand server (spawns server if needed, auto-terminates after idle)
  serve [timeout_seconds]    Manually start server with auto-idle timeout (default: 120s)
  stop                       Immediately stop all AI processes and reclaim RAM
  install-runtime            Download and install Snapdragon-optimized llama.cpp binaries
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
  status) cmd_status ;;
  models) cmd_models ;;
  select) cmd_select "$@" ;;
  ask) cmd_ask "$@" ;;
  chat) cmd_chat "$@" ;;
  serve) cmd_serve "$@" ;;
  stop) cmd_stop ;;
  install-runtime) cmd_install_runtime ;;
  *) usage; exit 1 ;;
esac
