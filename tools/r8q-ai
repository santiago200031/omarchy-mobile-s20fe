#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tools/r8q-ai: Control and query on-device local AI on Samsung Galaxy S20 FE (r8q)
# Native Omarchy Mobile implementation over USB SSH (172.16.42.1)
# Strictly on-demand: Zero persistent background daemons.
set -euo pipefail

say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PHONE_SSH="$ROOT/tools/phone-ssh"
if [[ -n ${OMAMOBILE_SSH:-} ]]; then
  export OMAMOBILE_SSH_HOST="$OMAMOBILE_SSH"
fi

ensure_phone() {
  "$PHONE_SSH" "echo ok" >/dev/null 2>&1 \
    || die "Cannot connect to phone via $PHONE_SSH. Is USB networking active (and OMAMOBILE_SSH_KEY set)?"
}

run_remote() {
  "$PHONE_SSH" "$@"
}

cmd_status() {
  ensure_phone
  run_remote "omamobile-ai status"
}

cmd_models() {
  ensure_phone
  run_remote "omamobile-ai models"
}

cmd_select() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: tools/r8q-ai select <model.gguf>"
  ensure_phone
  run_remote "omamobile-ai select '$target'"
}

cmd_query() {
  local prompt="${*:-}"
  [[ -n "$prompt" ]] || die "Usage: tools/r8q-ai query \"Your prompt here\""
  ensure_phone
  say "Sending query to phone (on-demand server with idle auto-shutdown)..."
  run_remote "omamobile-ai chat $(python3 -c "import sys, shlex; print(shlex.quote(sys.argv[1]))" "$prompt")"
}

cmd_ask() {
  local prompt="${*:-}"
  [[ -n "$prompt" ]] || die "Usage: tools/r8q-ai ask \"Your prompt here\""
  ensure_phone
  say "Running one-shot CLI inference on phone (process exits immediately after answer)..."
  run_remote "omamobile-ai ask $(python3 -c "import sys, shlex; print(shlex.quote(sys.argv[1]))" "$prompt")"
}

cmd_stop() {
  ensure_phone
  run_remote "omamobile-ai stop"
}

cmd_install() {
  ensure_phone
  say "1. Deploying on-demand omamobile-ai runner to phone (/usr/local/bin/omamobile-ai)..."
  "$PHONE_SSH" 'cat > /usr/local/bin/omamobile-ai.new && chmod +x /usr/local/bin/omamobile-ai.new && mv /usr/local/bin/omamobile-ai.new /usr/local/bin/omamobile-ai && mkdir -p /home/alarm/models && chown -R alarm:alarm /home/alarm/models' < "$ROOT/tools/omamobile-ai"

  say "2. Installing Snapdragon-optimized llama.cpp runtime on phone..."
  run_remote "omamobile-ai install-runtime"
  ok "On-demand local AI installed on phone! Zero daemons enabled."
}

cmd_push_model() {
  local local_file="${1:-}"
  [[ -n "$local_file" ]] || die "Usage: tools/r8q-ai push-model <path/to/model.gguf>"
  [[ -f "$local_file" ]] || die "File not found: $local_file"
  ensure_phone

  local fname total_bytes local_sha remote_bytes
  fname=$(basename "$local_file")
  total_bytes=$(stat -c%s "$local_file")
  local_sha=$(sha256sum "$local_file" | awk '{print $1}')

  if [[ $(run_remote "sha256sum '/home/alarm/models/$fname' 2>/dev/null | awk '{print \$1}'" || true) == "$local_sha" ]]; then
    ok "Model $fname already present with matching sha256; selecting as default."
    run_remote "chown alarm:alarm '/home/alarm/models/$fname' && omamobile-ai select '$fname'"
    return 0
  fi

  remote_bytes=$(run_remote "mkdir -p /home/alarm/models && stat -c%s '/home/alarm/models/$fname.part' 2>/dev/null || echo 0")
  if [[ "$remote_bytes" -gt "$total_bytes" ]]; then
    run_remote "rm -f '/home/alarm/models/$fname.part'"
    remote_bytes=0
  fi

  say "Uploading $fname ($remote_bytes / $total_bytes bytes resumed) to phone /home/alarm/models/..."
  tail -c "+$((remote_bytes + 1))" "$local_file" | "$PHONE_SSH" "cat >> '/home/alarm/models/$fname.part'"
  run_remote "
    got=\$(sha256sum '/home/alarm/models/$fname.part' | awk '{print \$1}')
    [ \"\$got\" = '$local_sha' ] || { echo 'sha256 mismatch after upload' >&2; exit 1; }
    mv -f '/home/alarm/models/$fname.part' '/home/alarm/models/$fname'
    chown alarm:alarm '/home/alarm/models/$fname'
    omamobile-ai select '$fname'
  "
  ok "Model $fname verified ($local_sha), installed, and set as default!"
}

usage() {
  cat <<'EOF'
tools/r8q-ai: control and query on-device AI on Galaxy S20 FE (r8q)

Operates over USB SSH (172.16.42.1) on native Omarchy Mobile.
Strictly on-demand: Zero background daemons, zero idle RAM/CPU footprint.

Commands:
  status                     Show on-device AI status, PID, RSS memory, and default model
  models                     List local models available in phone's /home/alarm/models
  select <model.gguf>        Set active default model on phone
  query "<prompt>"           Send prompt to on-demand server (auto-shuts down after idle)
  ask "<prompt>"             One-shot direct CLI inference (process terminates immediately)
  stop                       Stop any active AI process on phone to free RAM instantly
  install                    Deploy omamobile-ai script and Snapdragon llama.cpp runtime to phone
  push-model <local.gguf>    Copy local GGUF model to phone's /home/alarm/models/
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
  status) cmd_status ;;
  models) cmd_models ;;
  select) cmd_select "$@" ;;
  query) cmd_query "$@" ;;
  ask) cmd_ask "$@" ;;
  stop) cmd_stop ;;
  install) cmd_install ;;
  push-model) cmd_push_model "$@" ;;
  *) usage; exit 1 ;;
esac
