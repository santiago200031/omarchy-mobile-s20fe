#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tools/r8q-ai: control and query the on-device AI supervisor on the
# Samsung Galaxy S20 FE (r8q) over the USB link.
#
# omamobile-ai.service owns the model: it starts llama-server lazily on the
# first request, proxies the OpenAI and llama.cpp router surfaces, and
# unloads the model after IDLE_TIMEOUT so the phone gets its RAM back. The
# supervisor keeps running (it is a small Rust process); `unload` frees the
# model, `stop` stops the unit too.
#
# The supervisor listens on 172.16.42.1:8080 (LISTEN_HOST in the device
# drop-in). When the laptop cannot reach it directly, every call falls back
# to the same API over tools/phone-ssh.
#
#   tools/r8q-ai status
#   tools/r8q-ai models
#   tools/r8q-ai ask "<prompt>"        (alias: query)
#   tools/r8q-ai unload
#   tools/r8q-ai stop | start
#   tools/r8q-ai push-model <file.gguf>
#
# OMAMOBILE_AI_URL overrides the API base (default http://172.16.42.1:8080),
# MAX_TOKENS the answer length (default 512), and OMAMOBILE_SSH_KEY is the
# key tools/phone-ssh uses for the systemctl and fallback paths.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PHONE_SSH="$ROOT/tools/phone-ssh"
BASE="${OMAMOBILE_AI_URL:-http://172.16.42.1:8080}"
TIMEOUT="${OMAMOBILE_AI_TIMEOUT:-600}"
MAX_TOKENS="${MAX_TOKENS:-512}"

say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

# Direct first (the supervisor binds the USB address); the API over SSH is
# the same on 127.0.0.1 and survives a firewall change on the phone.
MODE=direct
if ! curl -sSf --max-time 3 "$BASE/health" >/dev/null 2>&1; then
  MODE=ssh
fi

api() { # api METHOD PATH [JSON]
  local method=$1 path=$2 data=${3:-}
  if [[ $MODE == direct ]]; then
    if [[ -n $data ]]; then
      curl -sS --max-time "$TIMEOUT" -X "$method" "$BASE$path" \
        -H 'Content-Type: application/json' --data-binary "$data"
    else
      curl -sS --max-time "$TIMEOUT" -X "$method" "$BASE$path"
    fi
  else
    local url="http://127.0.0.1:8080$path"
    if [[ -n $data ]]; then
      printf '%s' "$data" | "$PHONE_SSH" \
        "curl -sS --max-time $TIMEOUT -X $method '$url' -H 'Content-Type: application/json' --data-binary @-"
    else
      "$PHONE_SSH" "curl -sS --max-time $TIMEOUT -X $method '$url'"
    fi
  fi
}

cmd_status() {
  local health
  health=$(api GET /health) || die "the supervisor does not answer ($MODE: $BASE)"
  printf '%s' "$health" | python3 -c '
import json, sys
r = json.load(sys.stdin)
s = r.get("stats") or {}
status = r.get("status", "?")
model = r.get("model", "?")
state = "loaded" if r.get("model_loaded") else "idle"
avail = int(s.get("mem_available_kb", 0)) // 1024
total = int(s.get("mem_total_kb", 0)) // 1024
swap_free = int(s.get("swap_free_kb", 0)) // 1024
swap_total = int(s.get("swap_total_kb", 0)) // 1024
print("status:  " + status)
print("model:   " + model + " (" + state + ")")
print("threads: " + str(r.get("threads")) + ", idle timeout " + str(r.get("idle_timeout_secs")) + " s")
print("memory:  " + str(avail) + " MiB available of " + str(total) + " MiB; swap "
      + str(swap_free) + "/" + str(swap_total) + " MiB free")
print("battery: " + str(s.get("battery", "?")) + "; load " + str(s.get("loadavg", "?")))
'
}

cmd_models() {
  local list
  list=$(api GET /v1/models) || die "the supervisor does not answer ($MODE: $BASE)"
  printf '%s' "$list" | python3 -c '
import json, sys
r = json.load(sys.stdin)
for m in r.get("data") or []:
    print("served: " + m.get("id", "?"))
'
  if [[ $MODE == ssh ]] || "$PHONE_SSH" true >/dev/null 2>&1; then
    "$PHONE_SSH" 'ls -lh /usr/share/omamobile-ai/models/*.gguf /var/lib/omamobile-ai/models/*.gguf 2>/dev/null' || true
  fi
}

cmd_ask() {
  local prompt="${*:-}" health model body reply
  [[ -n $prompt ]] || die "Usage: tools/r8q-ai ask \"Your prompt here\""
  health=$(api GET /health) || die "the supervisor does not answer ($MODE: $BASE)"
  model=$(printf '%s' "$health" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("model",""))')
  body=$(python3 - "$prompt" "$model" "$MAX_TOKENS" <<'PY'
import json, sys
prompt, model, limit = sys.argv[1], sys.argv[2], int(sys.argv[3])
print(json.dumps({
    "model": model,
    "messages": [{"role": "user", "content": prompt}],
    "max_tokens": limit,
    "temperature": 0.2,
}))
PY
)
  reply=$(api POST /v1/chat/completions "$body") || die "the request failed ($MODE: $BASE)"
  printf '%s' "$reply" | python3 -c '
import json, sys
r = json.load(sys.stdin)
if "error" in r:
    print("error: " + str(r["error"]), file=sys.stderr)
    sys.exit(1)
choice = (r.get("choices") or [{}])[0]
m = choice.get("message") or {}
text = (m.get("content") or "").strip()
reason = (m.get("reasoning_content") or "").strip()
print(text if text else reason)
t = r.get("timings") or {}
if t:
    print("[" + str(t.get("prompt_n")) + " prompt tok @ "
          + format(t.get("prompt_per_second", 0), ".2f") + " tok/s; "
          + str(t.get("predicted_n")) + " generated @ "
          + format(t.get("predicted_per_second", 0), ".2f") + " tok/s]",
          file=sys.stderr)
'
}

cmd_unload() {
  local out
  out=$(api POST /v1/unload) || die "the supervisor does not answer ($MODE: $BASE)"
  printf '%s' "$out" | python3 -c 'import json,sys; print("model: " + json.load(sys.stdin).get("status", "?"))'
}

cmd_stop() {
  # The supervisor may already be down: a failed unload is not an error here.
  api POST /v1/unload >/dev/null 2>&1 || true
  "$PHONE_SSH" 'systemctl stop omamobile-ai' || die "could not stop omamobile-ai on the phone"
  ok "omamobile-ai.service stopped"
}

cmd_start() {
  "$PHONE_SSH" 'systemctl start omamobile-ai' || die "could not start omamobile-ai on the phone"
  local i
  for i in $(seq 1 15); do
    if curl -sSf --max-time 2 "$BASE/health" >/dev/null 2>&1 \
      || "$PHONE_SSH" 'curl -sSf --max-time 2 http://127.0.0.1:8080/health' >/dev/null 2>&1; then
      ok "omamobile-ai.service is answering"
      return 0
    fi
    sleep 1
  done
  die "omamobile-ai.service started but does not answer"
}

cmd_push_model() {
  local local_file="${1:-}" fname total_bytes local_sha remote_bytes remote_dir
  [[ -n $local_file ]] || die "Usage: tools/r8q-ai push-model <path/to/model.gguf>"
  [[ -f $local_file ]] || die "File not found: $local_file"
  fname=$(basename "$local_file")
  [[ $fname != *" "* ]] || die "a model file name with spaces cannot be selected at boot"
  remote_dir=/var/lib/omamobile-ai/models
  total_bytes=$(stat -c%s "$local_file")
  local_sha=$(sha256sum "$local_file" | awk '{print $1}')

  remote_bytes=$("$PHONE_SSH" "mkdir -p '$remote_dir' && stat -c%s '$remote_dir/$fname.part' 2>/dev/null || echo 0")
  if [[ "$remote_bytes" -gt "$total_bytes" ]]; then
    "$PHONE_SSH" "rm -f '$remote_dir/$fname.part'"
    remote_bytes=0
  fi

  say "Uploading $fname ($remote_bytes / $total_bytes bytes resumed) to $remote_dir"
  tail -c "+$((remote_bytes + 1))" "$local_file" \
    | "$PHONE_SSH" "cat >> '$remote_dir/$fname.part'"
  "$PHONE_SSH" "
    set -e
    got=\$(sha256sum '$remote_dir/$fname.part' | awk '{print \$1}')
    [ \"\$got\" = '$local_sha' ] || { echo 'sha256 mismatch after upload' >&2; exit 1; }
    mv -f '$remote_dir/$fname.part' '$remote_dir/$fname'
    mkdir -p /etc/omamobile-ai.conf.d
    printf 'MODEL_PATH=%s\nMODEL_ID=%s\n' '$remote_dir/$fname' '${fname%.gguf}' \
      > /etc/omamobile-ai.conf.d/20-model.conf
    systemctl restart omamobile-ai
  "
  ok "model $fname verified ($local_sha), selected, and the supervisor restarted"
  local i
  for i in $(seq 1 15); do
    if curl -sSf --max-time 2 "$BASE/health" >/dev/null 2>&1; then
      ok "the supervisor is answering"
      return 0
    fi
    sleep 1
  done
  warn "the model is in place, but the supervisor has not answered yet; check tools/r8q-ai status"
}

usage() {
  cat <<'EOF'
tools/r8q-ai: control and query the on-device AI supervisor (r8q, S20 FE)

The omamobile-ai.service supervisor owns llama-server: it starts the model
on the first request, proxies the OpenAI and llama.cpp router surfaces, and
unloads it after IDLE_TIMEOUT. Calls go to http://172.16.42.1:8080 and fall
back to the same API over tools/phone-ssh.

Commands:
  status                     Supervisor state, model, RAM, battery and load
  models                     The model the supervisor serves, and the GGUFs on the phone
  ask "<prompt>"             One chat completion (alias: query)
  unload                     Free the model's RAM now; the supervisor stays up
  stop                       Stop llama-server and the supervisor unit
  start                      Start the supervisor and wait until it answers
  push-model <local.gguf>    Upload a model to /var/lib/omamobile-ai/models and serve it

Environment: OMAMOBILE_AI_URL, OMAMOBILE_AI_TIMEOUT, MAX_TOKENS,
OMAMOBILE_SSH_KEY.
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
  status) cmd_status ;;
  models) cmd_models ;;
  ask | query) cmd_ask "$@" ;;
  unload) cmd_unload ;;
  stop) cmd_stop ;;
  start) cmd_start ;;
  push-model) cmd_push_model "$@" ;;
  install) die "the omamobile-ai package provides the supervisor: pacman -S omamobile-ai" ;;
  *) usage; exit 1 ;;
esac
