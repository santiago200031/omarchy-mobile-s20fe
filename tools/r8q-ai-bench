#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/r8q-ai-bench: run the Adreno GPU wedge repro (board/failed/08) as a
# one-command PASS/FAIL test against the running kernel — the historic
# wedger is `llama-bench -ngl 99` on LFM3-1.7B: before the a6xx recover
# fix it produced "msm_dpu: hangcheck detected gpu lockup" +
# "a6xx_recover: cx gdsc didn't collapse" and lost the Vulkan device.
#
#   tools/r8q-ai-bench [--model FILE.gguf] [--cpu]
#
# Checks first that the phone answers, that Vulkan sees the Adreno
# (vulkaninfo), and that a Vulkan llama-bench exists; --cpu runs the
# CPU-only installed binary for a baseline instead. The bench output, the
# dmesg GPU tail and the verdict land in logs/r8q/ai-bench-*.log.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

REMOTE="${REMOTE:-root@172.16.42.1}"
SSH=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
     -o ConnectTimeout=8 -o ServerAliveInterval=5 -q)
SSH_KEY="${OMAMOBILE_SSH_KEY:-$HOME/.ssh/omamobile-r8q}"
[[ -f "$SSH_KEY" ]] && SSH+=(-i "$SSH_KEY" -o IdentitiesOnly=yes)
MODEL="/usr/share/omamobile-ai/models/LFM3-1.7B-Q4_K_M.gguf"
BENCH=""
CPU=0
while [[ ${1:-} == --* ]]; do
  case $1 in
    --model) MODEL="$2"; shift 2 ;;
    --cpu) CPU=1; shift ;;
    --) shift; break ;;
    *) die "unknown option: $1 (try --model FILE.gguf or --cpu)" ;;
  esac
done
R8Q_LLAMA_VK_SRC="${R8Q_LLAMA_VK_SRC:-/home/alarm/build/pkgs/omamobile-llama/src/llama.cpp-98d67c8d536dc584897c4adb2510509796517222}"

say "Waiting for the phone"
for _ in $(seq 1 30); do "${SSH[@]}" "$REMOTE" true >/dev/null 2>&1 && break; sleep 4; done
"${SSH[@]}" "$REMOTE" true >/dev/null 2>&1 || die "$REMOTE did not answer"

# ---- pick the bench binary ----
if ((CPU)); then
  BENCH="/usr/bin/llama-bench"
else
  BENCH=$("${SSH[@]}" "$REMOTE" "ls $R8Q_LLAMA_VK_SRC/build-vk/bin/llama-bench 2>/dev/null" || true)
  [[ -n $BENCH ]] || BENCH="/usr/bin/llama-bench"
fi
say "bench: $BENCH $( ((CPU)) && echo '(CPU baseline)' )"
"${SSH[@]}" "$REMOTE" "[ -x $BENCH ]" 2>/dev/null || die "no llama-bench at $BENCH on the phone"

if ((! CPU)); then
  say "Checking Vulkan sees the Adreno"
  gpu=$("${SSH[@]}" "$REMOTE" "vulkaninfo --summary 2>/dev/null | grep -m1 deviceName" || true)
  [[ -n $gpu ]] || die "vulkaninfo sees no GPU — is renderD128 up? (modules: tools/r8q-modules --reboot)"
  ok "$gpu"
fi

# ---- run the repro ----
mkdir -p "$ROOT/logs/r8q"
stamp=$(date +%Y%m%d-%H%M%S)
LOG="$ROOT/logs/r8q/ai-bench-$stamp.log"
say "Running the repro: llama-bench -ngl 99 -p 512 -n 128 (this can wedge the GPU — that is the test)"
"${SSH[@]}" "$REMOTE" "timeout 300 $BENCH -m $MODEL -ngl 99 -p 512 -n 128 2>&1; \
  echo '=== dmesg GPU tail ==='; dmesg | grep -iE 'a6xx|gdsc|hangcheck|gpu lockup|device lost' | tail -8" >"$LOG" 2>&1 || true
cat "$LOG" | tail -14

# ---- verdict ----
# The honest ladder: a PASS needs the result table (llama-bench prints the
# pp512/tg128 rows only when the run completed). The device-enumeration line
# alone means the backend engaged, not that compute finished — and an SSH
# drop can leave the dmesg section empty, which must never grade as clean.
wedge=$(grep -cE "cx gdsc didn't collapse|gpu lockup|device lost" "$LOG" || true)
table=$(grep -cE "pp512|tg128" "$LOG" || true)
vulkan=$(grep -c "Vulkan" "$LOG" || true)
printf '\n'
if ((wedge > 0)); then
  printf '\e[1;31m==>\e[0m WEDGE: the GPU-recovery failure signature is present (%s hit(s)) — the fix did not hold. Reboot the phone before further GPU work (board/failed/08 rule).\n' "$wedge"
  exit 1
fi
if ((table > 0)); then
  printf '\e[1;32m==>\e[0m PASS: the result table is present and dmesg is clean. Log: %s\n' "$LOG"
  exit 0
fi
if ((vulkan > 0)); then
  printf '\e[1;33m==>\e[0m INCOMPLETE: Vulkan engaged but no result table — the bench hung or the SSH link dropped mid-run. Treat as unproven; check the log, re-run. Log: %s\n' "$LOG"
  exit 3
fi
printf '\e[1;33m==>\e[0m CPU-ONLY: the GPU backend never engaged (no Vulkan lines). Build it: %s -> cmake -B build-vk -DGGML_VULKAN=ON && cmake --build build-vk --target llama-bench -j8\n' "$R8Q_LLAMA_VK_SRC"
exit 2
