#!/bin/bash
# SPDX-License-Identifier: MIT
# r8q-boot: Pack and verify Android header-v2 recovery/boot images for Samsung Galaxy S20 FE (r8q).
#
# Hardware: Qualcomm SM8250 (Snapdragon 865), single-slot non-A/B storage.
# Test strategy: Boots from recovery slot (sda24) or kexec, preserving LineageOS on boot (sda23).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KERNEL_OUT="${KERNEL_OUT:-$HOME/omamobile-kernel/out-r8q}"
TOOLS_DIR="$HOME/.cache/omamobile/toolchain/mkbootimg"
MKBOOTIMG="${MKBOOTIMG:-$TOOLS_DIR/mkbootimg.py}"

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: tools/r8q-boot <command> [args]

Commands:
  pack [output_img]    Pack header-v2 image (defaults to \$KERNEL_OUT/recovery-omamobile.img)
  verify [img]         Inspect header, offsets, and sha256 of a packed image
  info                 Show target hardware offsets and live boot parameters
EOF
}

cmd_info() {
  cat <<EOF
Target Device: Samsung Galaxy S20 FE (r8q / SM-G780G)
SoC: Qualcomm Snapdragon 865 (SM8250 Kona)
Header Version: 2
Page Size:      4096
Base Address:   0x00000000
Kernel Offset:  0x00008000
Ramdisk Offset: 0x01000000
Tags Offset:    0x00000100
DTB Offset:     0x01f00000
Kernel Artifact: $KERNEL_OUT/arch/arm64/boot/Image.gz
DTB Artifact:    $KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb
EOF
}

cmd_pack() {
  local out_img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  local kernel="$KERNEL_OUT/arch/arm64/boot/Image.gz"
  local dtb="$KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb"

  [[ -f $kernel ]] || die "Kernel not found at $kernel (run bin/omamobile kernel first)"
  [[ -f $dtb ]] || die "DTB not found at $dtb (run bin/omamobile kernel first)"
  [[ -f $MKBOOTIMG ]] || die "mkbootimg tool not found at $MKBOOTIMG"

  local stage
  stage=$(mktemp -d)

  say "Building guarded initramfs in $stage"
  mkdir -p "$stage/root" "$stage/root/etc" "$stage/root/dev" "$stage/root/proc" "$stage/root/sys" "$stage/root/run"

  # Stage shared initramfs init
  cp "$ROOT/initramfs/init" "$stage/root/init"
  chmod 755 "$stage/root/init"

  # Force storage guard into 100% read-only mode for r8q bring-up
  touch "$stage/root/etc/omamobile-ufs-rw"
  chmod 644 "$stage/root/etc/omamobile-ufs-rw"

  # Stage SSH authorized keys from host if available
  mkdir -p "$stage/root/etc/dropbear"
  for keyfile in "$HOME"/.ssh/id_*.pub; do
    if [[ -f $keyfile ]]; then
      cat "$keyfile" >> "$stage/root/etc/dropbear/authorized_keys"
    fi
  done
  if [[ -f "$stage/root/etc/dropbear/authorized_keys" ]]; then
    chmod 600 "$stage/root/etc/dropbear/authorized_keys"
  fi

  # Build cpio ramdisk
  local ramdisk="$stage/initramfs.cpio.gz"
  (
    cd "$stage/root"
    find . -mindepth 1 | cpio -H newc -o | gzip -9 -n > "$ramdisk"
  )

  say "Packing Android header-v2 image: $out_img"
  mkdir -p "$(dirname "$out_img")"

  python3 "$MKBOOTIMG" \
    --header_version 2 \
    --pagesize 4096 \
    --base 0x00000000 \
    --kernel_offset 0x00008000 \
    --ramdisk_offset 0x01000000 \
    --tags_offset 0x00000100 \
    --dtb_offset 0x01f00000 \
    --cmdline "console=tty0 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init omamobile.ufs-probe" \
    --kernel "$kernel" \
    --ramdisk "$ramdisk" \
    --dtb "$dtb" \
    --output "$out_img"

  say "Image packed successfully:"
  rm -rf "$stage"
  ls -lh "$out_img"
  sha256sum "$out_img"
}

cmd_verify() {
  local img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  [[ -f $img ]] || die "Image not found at $img"
  say "Verifying image: $img"
  ls -lh "$img"
  sha256sum "$img"
  local magic
  magic=$(dd if="$img" bs=8 count=1 2>/dev/null)
  if [[ $magic == "ANDROID!" ]]; then
    say "Magic check: ANDROID! header verified"
  else
    die "Invalid magic bytes in $img: '$magic' (expected ANDROID!)"
  fi
}

cmd="${1:-}"
shift || true
case $cmd in
  pack) cmd_pack "$@" ;;
  verify) cmd_verify "$@" ;;
  info) cmd_info ;;
  *) usage; exit 1 ;;
esac
