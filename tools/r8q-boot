#!/bin/bash
# SPDX-License-Identifier: MIT
# r8q-boot: Pack and verify Android header-v2 recovery/boot images for Samsung Galaxy S20 FE (r8q).
#
# Hardware: Qualcomm SM8250 (Snapdragon 865), single-slot non-A/B storage.
# Test strategy: Boots from recovery slot (sda24) or kexec, preserving LineageOS on boot (sda23).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KERNEL_OUT="${KERNEL_OUT:-$HOME/omamobile-kernel/out-r8q}"
TOOLS_DIR="$HOME/.cache/omamobile/toolchain/mkbootimg"
MKBOOTIMG="${MKBOOTIMG:-$TOOLS_DIR/mkbootimg.py}"
AVBTOOL="$HOME/.cache/omamobile/toolchain/avb/avbtool.py"
AVBKEY="$HOME/.cache/omamobile/toolchain/avb/test/data/testkey_rsa4096.pem"

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: tools/r8q-boot <command> [args]

Commands:
  pack [--dual-boot] [--overlay NAME]... [--rescue-test] [output_img]
                                   Pack header-v2 image (defaults to \$KERNEL_OUT/recovery-omamobile.img)
                                   Overlays come from device/r8q/overlays/<NAME>.dtso or R8Q_OVERLAYS=
                                   --rescue-test: also stage the kernel modules, the
                                   SDX55M BHI firmware (see R8Q_RESCUE_FW) and
                                   pciutils into the initramfs, for SD-less
                                   modem tests from the rescue shell
  verify [img]                     Inspect header, offsets, and sha256 of a packed image
  info                             Show target hardware offsets and live boot parameters
EOF
}

cmd_info() {
  cat <<EOF
Target Device: Samsung Galaxy S20 FE (r8q / SM-G780G)
SoC: Qualcomm Snapdragon 865 (SM8250 Kona)
Header Version: 2
Page Size:      4096
Base Address:   0x00000000
Kernel Offset:  0x00008000
Ramdisk Offset: 0x01000000
Tags Offset:    0x00000100
DTB Offset:     0x01f00000
Kernel Artifact: $KERNEL_OUT/arch/arm64/boot/Image.gz
DTB Artifact:    $KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb
EOF
}

cmd_pack() {
  local dual_boot=0 rescue_test=0
  local -a overlays=()
  local ov
  for ov in ${R8Q_OVERLAYS:-}; do
    overlays+=("$ov")
  done
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dual-boot)
        dual_boot=1
        shift
        ;;
      --rescue-test)
        rescue_test=1
        shift
        ;;
      --overlay)
        [[ -n "${2:-}" ]] || die "--overlay requires an overlay name"
        overlays+=("$2")
        shift 2
        ;;
      --overlay=*)
        overlays+=("${1#--overlay=}")
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "Unknown pack option: $1"
        ;;
      *)
        break
        ;;
    esac
  done
  local out_img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  local kernel="$KERNEL_OUT/arch/arm64/boot/Image"
  local dtb="$KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb"
  local cache_dir="$HOME/.cache/omamobile/alpine"
  local ver="3.24.2"
  local tarball="alpine-minirootfs-$ver-aarch64.tar.gz"

  [[ -f $kernel ]] || die "Kernel not found at $kernel (run bin/omamobile kernel first)"
  # The initramfs ships no modules, so UFS must be built into the Image. A
  # build without the r8q config fragment (e.g. bin/omamobile kernel run
  # without DEVICE=r8q) silently produces CONFIG_SCSI_UFS_QCOM=m and the
  # phone then boots to "0 disks" (NOTES.md 30). Fail at pack time instead.
  grep -aq "ufshcd-qcom" "$kernel" ||
    die "Image lacks the built-in ufshcd-qcom driver (CONFIG_SCSI_UFS_QCOM != y): rebuild with DEVICE=r8q (NOTES.md 30)"
  grep -aq "qcom,sm8250-qmp-ufs-phy" "$kernel" ||
    die "Image lacks the built-in SM8250 UFS PHY driver (CONFIG_PHY_QCOM_QMP_UFS != y): rebuild with DEVICE=r8q (NOTES.md 30)"
  [[ -f $dtb ]] || die "DTB not found at $dtb (run bin/omamobile kernel first)"
  [[ -f $MKBOOTIMG ]] || die "mkbootimg tool not found at $MKBOOTIMG"

  local pack_dtb="$dtb"
  local dtc_bin="$KERNEL_OUT/scripts/dtc/dtc"
  local fdtoverlay_bin="$KERNEL_OUT/scripts/dtc/fdtoverlay"
  [[ -x $dtc_bin ]] || dtc_bin="$(command -v dtc || true)"
  [[ -x $fdtoverlay_bin ]] || fdtoverlay_bin="$(command -v fdtoverlay || true)"

  local stage
  stage=$(mktemp -d)

  say "Staging Alpine Linux ARM64 rootfs in $stage"
  mkdir -p "$stage/root" "$cache_dir/apks"
  tar -xzf "$cache_dir/$tarball" -C "$stage/root"

  local pkgs="dropbear kexec-tools e2fsprogs e2fsprogs-extra"
  # rsync is for a native root install from the rescue shell: copy the root
  # image off the SD card onto userdata with owners, ACLs and xattrs intact.
  ((rescue_test)) && pkgs="$pkgs pciutils rsync"
  say "Fetching and staging packages ($pkgs)"
  local apks
  apks=$(python3 -I "$ROOT/tools/alpine-fetch.py" "$ver" "$cache_dir/apks" $pkgs) ||
    die "alpine-fetch.py failed"
  for apk in $apks; do
    tar -xzf "$apk" -C "$stage/root" --exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.*.sh' 2>/dev/null || true
  done

  # Stage shared initramfs init
  cp "$ROOT/initramfs/init" "$stage/root/init"
  chmod 755 "$stage/root/init"

  # Storage guard allowlist: leave empty for --dual-boot (all UFS stays read-only),
  # or allow only userdata (sda36) for native install.
  if [[ $dual_boot -eq 1 ]]; then
    : > "$stage/root/etc/omamobile-ufs-rw"
  else
    echo "userdata" > "$stage/root/etc/omamobile-ufs-rw"
    # A native install mounts the root from userdata. Identify it by its
    # filesystem label so a wrong (encrypted, foreign) partition is never
    # mounted: the init refuses anything but "omamobile-root".
    echo "omamobile-root" > "$stage/root/etc/omamobile-root-label"
  fi
  chmod 644 "$stage/root/etc/omamobile-ufs-rw"
  echo "Samsung Galaxy S20 FE (r8q)" > "$stage/root/etc/omamobile-usb-product"

  # Stage SSH authorized keys from host if available
  mkdir -p "$stage/root/etc/dropbear" "$stage/root/root/.ssh"
  for keyfile in "$HOME"/.ssh/id_*.pub "$HOME"/.ssh/*.pub; do
    if [[ -f $keyfile ]]; then
      cat "$keyfile" >> "$stage/root/etc/dropbear/authorized_keys"
      cat "$keyfile" >> "$stage/root/root/.ssh/authorized_keys"
    fi
  done
  chmod 700 "$stage/root/root/.ssh" 2>/dev/null || true
  chmod 600 "$stage/root/etc/dropbear/authorized_keys" "$stage/root/root/.ssh/authorized_keys" 2>/dev/null || true
  # Allow passwordless root login as failsafe
  sed -i 's/^root:[^:]*:/root::/' "$stage/root/etc/shadow" 2>/dev/null || true

  if ((rescue_test)); then
    # SD-less modem test: kernel modules and the SDX55M BHI firmware live
    # in the initramfs itself, so the rescue shell can insmod + bind with
    # no SD card and no Arch root. Modules are insmodded by hand in
    # dependency order (no depmod in the initramfs); the firmware files
    # below are the phone's own, pulled read-only over SSH (Google files,
    # never committed).
    local mod_tar
    mod_tar=$(ls -t "$KERNEL_OUT"/modules-*.tar.zst 2>/dev/null | sed -n 1p)
    [[ -n ${mod_tar:-} ]] || die "--rescue-test needs a modules tarball in \$KERNEL_OUT (run bin/omamobile modules first)"
    say "rescue-test: staging modules from $mod_tar"
    mkdir -p "$stage/root/lib/modules"
    tar --zstd -xf "$mod_tar" -C "$stage/root/lib/modules" || die "unpacking $mod_tar failed"
    local fw_dir="${R8Q_RESCUE_FW:-$HOME/omamobile-kernel/r8q-fw}"
    for fw in sbl1.mbn sec.elf; do
      [[ -f $fw_dir/$fw ]] || die "--rescue-test needs $fw_dir/$fw on the laptop"
    done
    say "rescue-test: staging sdx55m BHI firmware from $fw_dir"
    mkdir -p "$stage/root/lib/firmware/qcom/sdx55m"
    cp "$fw_dir"/sbl1.mbn "$fw_dir"/sec.elf "$stage/root/lib/firmware/qcom/sdx55m/"
    local rs_bin="${R8Q_SAHARA_RS_BIN:-$ROOT/tools/r8q-sahara-rs/target/aarch64-unknown-linux-musl/release/r8q-sahara}"
    if [[ -f $rs_bin ]]; then
      say "rescue-test: staging Rust Sahara loader $rs_bin"
      mkdir -p "$stage/root/usr/local/bin"
      cp "$rs_bin" "$stage/root/usr/local/bin/r8q-sahara-rs"
      chmod 755 "$stage/root/usr/local/bin/r8q-sahara-rs"
    else
      say "rescue-test: no Rust Sahara loader at $rs_bin (skipping)"
    fi
  fi

  # Build cpio ramdisk
  local ramdisk="$stage/initramfs.cpio.gz"
  say "Creating compressed initramfs ramdisk"
  set -o pipefail
  (
    cd "$stage/root"
    find . -mindepth 1 -print0 | cpio -H newc -o --null 2>"$stage/cpio-errors.log" | gzip -9 -n > "$ramdisk"
  )
  set +o pipefail
  if grep -vE '^[0-9]+ blocks?$' "$stage/cpio-errors.log" | grep -c . >/dev/null; then
    grep -vE '^[0-9]+ blocks?$' "$stage/cpio-errors.log" | sed -n '1,5p'
    die "cpio reported errors building the initramfs"
  fi
  say "initramfs: $(du -h "$ramdisk" | cut -f1) from $(find "$stage/root" -mindepth 1 | wc -l) staged files"

  if [[ ${#overlays[@]} -gt 0 ]]; then
    [[ -x $dtc_bin ]] || die "dtc binary not found (run bin/omamobile kernel first)"
    [[ -x $fdtoverlay_bin ]] || die "fdtoverlay binary not found (run bin/omamobile kernel first)"
    mkdir -p "$stage/overlays"
    local -a ov_dtbos=()
    local dtso dtbo

    # Check overlay dependency order:
    # audio-sound requires remoteprocs + audio-amps
    # camera requires kernel modules (camcc_sm8250, qcom-camss, hi847)
    local has_remoteprocs=0 has_audio_amps=0 has_audio_sound=0 has_camera=0
    for ov in "${overlays[@]}"; do
      case "$ov" in
        remoteprocs) has_remoteprocs=1 ;;
        audio-amps) has_audio_amps=1 ;;
        audio-sound) has_audio_sound=1 ;;
        camera) has_camera=1 ;;
      esac
    done

    # Validate dependency order
    if [[ $has_audio_sound -eq 1 ]]; then
      [[ $has_remoteprocs -eq 1 ]] || die "audio-sound requires remoteprocs overlay (ADSP must run first)"
      [[ $has_audio_amps -eq 1 ]] || die "audio-sound requires audio-amps overlay (I2C11 + GPI DMA1 must be enabled)"
      say "audio-sound: dependency check passed (remoteprocs + audio-amps present)"
    fi
    if [[ $has_camera -eq 1 ]]; then
      # Camera overlay needs camcc_sm8250, qcom-camss, hi847 modules installed
      say "camera: overlay enables CAMSS/CCI10/HI-847 — modules must be installed on target"
    fi

    for ov in "${overlays[@]}"; do
      [[ $ov =~ ^[a-z0-9-]+$ ]] || die "Invalid overlay name: '$ov'"
      dtso="$ROOT/device/r8q/overlays/$ov.dtso"
      [[ -f $dtso ]] || die "Overlay not found: $dtso"
      dtbo="$stage/overlays/$ov.dtbo"
      "$dtc_bin" -q -@ -I dts -O dtb -o "$dtbo" "$dtso" || die "Failed to compile overlay: $dtso"
      ov_dtbos+=("$dtbo")
    done
    pack_dtb="$stage/r8q-overlaid.dtb"
    "$fdtoverlay_bin" -i "$dtb" -o "$pack_dtb" "${ov_dtbos[@]}" || die "Failed to apply overlays: ${overlays[*]}"
    say "Applied DTB overlays: ${overlays[*]}"
  fi

  say "Packing Android header-v2 image: $out_img"
  mkdir -p "$(dirname "$out_img")"

  # Downstream Android recovery_dtbo conflicts with mainline 7.x DTB paths.
  # Leave recovery_dtbo empty (dtbo_size=0) matching stock boot.img.
  local dtbo_arg=()
  if [[ "${OMAMOBILE_WITH_DTBO:-0}" == "1" ]] && [[ -f "$KERNEL_OUT/recovery_dtbo.img" ]]; then
    dtbo_arg=(--recovery_dtbo "$KERNEL_OUT/recovery_dtbo.img")
  fi

  local cmdline="console=tty0 console=ttyGS0 systemd.unit=multi-user.target consoleblank=0 clk_ignore_unused pd_ignore_unused mem_sleep_default=s2idle systemd.mask=sleep.target systemd.mask=suspend.target systemd.mask=hibernate.target systemd.mask=hybrid-sleep.target panic=10 softlockup_panic=1 rdinit=/init omamobile.ufs-probe irqchip.gicv3_pseudo_nmi=1"
  if [[ $dual_boot -eq 1 ]]; then
    cmdline="$cmdline omamobile.loop=${OMAMOBILE_LOOP:-/omarchy-r8q.img}"
  fi
  if [[ -n "${OMAMOBILE_CMDLINE_EXTRA:-}" ]]; then
    cmdline="$cmdline $OMAMOBILE_CMDLINE_EXTRA"
  fi

  python3 "$MKBOOTIMG" \
    --header_version 2 \
    --pagesize 4096 \
    --base 0x00000000 \
    --kernel_offset 0x00008000 \
    --ramdisk_offset 0x01000000 \
    --tags_offset 0x00000100 \
    --dtb_offset 0x01f00000 \
    --os_version 16.0.0 \
    --os_patch_level 2026-10 \
    --cmdline "$cmdline" \
    --kernel "$kernel" \
    --ramdisk "$ramdisk" \
    --dtb "$pack_dtb" \
    "${dtbo_arg[@]}" \
    --output "$out_img"

  say "Signing image with AVB hash footer matching LineageOS vbmeta"
  python3 "$AVBTOOL" add_hash_footer \
    --image "$out_img" \
    --partition_size 82694144 \
    --partition_name recovery \
    --algorithm SHA256_RSA4096 \
    --key "$AVBKEY" \
    --rollback_index 1790812800 \
    --salt c87c8f874194bd7fde350e71426ac253760df3146460905df3fc630afc2a0322 \
    --prop com.android.build.recovery.fingerprint:samsung/lineage_r8q/r8q:16/BP4A.251205.006/e8c0c141f5:userdebug/release-keys

  local tar_out="${out_img%.img}.tar.md5"
  say "Creating Samsung Odin/Heimdall flashable TAR package: $tar_out"
  (
    cd "$(dirname "$out_img")"
    tar -H ustar -c "$(basename "$out_img")" > "${tar_out%.md5}"
    md5sum -t "${tar_out%.md5}" >> "${tar_out%.md5}"
    mv "${tar_out%.md5}" "$tar_out"
  )

  say "Image packed, AVB signed, and TAR created successfully:"
  rm -rf "$stage"
  ls -lh "$out_img" "$tar_out"
  sha256sum "$out_img"
  sha256sum "$out_img"
}

cmd_verify() {
  local img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  [[ -f $img ]] || die "Image not found at $img"
  say "Verifying image: $img"
  ls -lh "$img"
  sha256sum "$img"
  local magic
  magic=$(dd if="$img" bs=8 count=1 2>/dev/null)
  if [[ $magic == "ANDROID!" ]]; then
    say "Magic check: ANDROID! header verified"
  else
    die "Invalid magic bytes in $img: '$magic' (expected ANDROID!)"
  fi
}

cmd_flash_recovery() {
  local img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  local backup_dir="$HOME/android/backups/r8q-nv"
  local expected_boot_sha="2210cd703c8ab9ea96874a071a362bc088dddc2b4df524d0e8be767a26b3e3b4"

  [[ -f $img ]] || die "Image not found at $img (run pack first)"
  [[ -d $backup_dir ]] || die "Backup directory not found at $backup_dir"

  say "Safety check 1: Checking adb connection to phone"
  adb get-state >/dev/null 2>&1 || die "Phone not detected over adb"

  say "Safety check 2: Verifying primary LineageOS boot partition (sda23) is untouched"
  local live_boot_sha
  live_boot_sha=$(adb shell "sha256sum /dev/block/by-name/boot 2>/dev/null | awk '{print \$1}'" | tr -d '\r\n')
  [[ $live_boot_sha == "$expected_boot_sha" ]] || die "Boot partition sha mismatch! Expected $expected_boot_sha, got '$live_boot_sha'"
  say "LineageOS primary boot slot is 100% verified and untouched ($live_boot_sha)"

  say "Pushing test recovery image to /data/local/tmp/"
  local img_sha img_bytes
  img_sha=$(sha256sum "$img" | awk '{print $1}')
  img_bytes=$(stat -c%s "$img")
  adb push "$img" /data/local/tmp/recovery-omamobile.img >/dev/null

  say "Verifying pushed image checksum on phone"
  local pushed_sha
  pushed_sha=$(adb shell "sha256sum /data/local/tmp/recovery-omamobile.img 2>/dev/null | awk '{print \$1}'" | tr -d '\r\n')
  [[ $pushed_sha == "$img_sha" ]] || die "Pushed image checksum mismatch on phone"

  say "Writing test recovery image to /dev/block/by-name/recovery (sda24)"
  adb shell "dd if=/data/local/tmp/recovery-omamobile.img of=/dev/block/by-name/recovery bs=4096 conv=fsync 2>/dev/null"
  adb shell "rm -f /data/local/tmp/recovery-omamobile.img"

  say "Verifying recovery partition readback checksum"
  local blocks=$(( (img_bytes + 4095) / 4096 ))
  local readback_sha
  readback_sha=$(adb shell "dd if=/dev/block/by-name/recovery bs=4096 count=$blocks 2>/dev/null | { head -c $img_bytes; cat >/dev/null; } | sha256sum | awk '{print \$1}'" | tr -d '\r\n')
  [[ $readback_sha == "$img_sha" ]] || die "Recovery readback checksum mismatch ($readback_sha != $img_sha)"

  say "Recovery partition successfully updated and verified ($img_sha)"
  say "Rebooting into test recovery image..."
  adb reboot recovery
  say "Phone rebooted to recovery. Waiting for USB network gadget on 172.16.42.1..."
}

cmd_restore_recovery() {
  local backup="$HOME/android/backups/r8q-nv/recovery.img"
  local expected_sha="36855fb919f3af98d0e4e45692672d4a96989e9090a4cc882754139543cfef35"

  [[ -f $backup ]] || die "Stock recovery backup not found at $backup"
  say "Safety check: checking adb connection"
  adb get-state >/dev/null 2>&1 || die "Phone not detected over adb"

  say "Restoring stock LineageOS recovery from $backup"
  adb push "$backup" /data/local/tmp/recovery.img >/dev/null
  adb shell "dd if=/data/local/tmp/recovery.img of=/dev/block/by-name/recovery bs=4096 conv=fsync 2>/dev/null"
  adb shell "rm -f /data/local/tmp/recovery.img"

  local restored_sha
  restored_sha=$(adb shell "sha256sum /dev/block/by-name/recovery | awk '{print \$1}'" | tr -d '\r\n')
  [[ $restored_sha == "$expected_sha" ]] || die "Restore sha mismatch!"
  say "Stock LineageOS recovery successfully restored and verified ($restored_sha)"
}

cmd="${1:-}"
shift || true
case $cmd in
  pack) cmd_pack "$@" ;;
  verify) cmd_verify "$@" ;;
  flash-recovery) cmd_flash_recovery "$@" ;;
  restore-recovery) cmd_restore_recovery ;;
  info) cmd_info ;;
  *) usage; exit 1 ;;
esac
