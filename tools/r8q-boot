#!/bin/bash
# SPDX-License-Identifier: MIT
# r8q-boot: Pack and verify Android header-v2 recovery/boot images for Samsung Galaxy S20 FE (r8q).
#
# Hardware: Qualcomm SM8250 (Snapdragon 865), single-slot non-A/B storage.
# Test strategy: Boots from recovery slot (sda24) or kexec, preserving LineageOS on boot (sda23).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KERNEL_OUT="${KERNEL_OUT:-$HOME/omamobile-kernel/out-r8q}"
TOOLS_DIR="$HOME/.cache/omamobile/toolchain/mkbootimg"
MKBOOTIMG="${MKBOOTIMG:-$TOOLS_DIR/mkbootimg.py}"

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: tools/r8q-boot <command> [args]

Commands:
  pack [output_img]    Pack header-v2 image (defaults to \$KERNEL_OUT/recovery-omamobile.img)
  verify [img]         Inspect header, offsets, and sha256 of a packed image
  info                 Show target hardware offsets and live boot parameters
EOF
}

cmd_info() {
  cat <<EOF
Target Device: Samsung Galaxy S20 FE (r8q / SM-G780G)
SoC: Qualcomm Snapdragon 865 (SM8250 Kona)
Header Version: 2
Page Size:      4096
Base Address:   0x00000000
Kernel Offset:  0x00008000
Ramdisk Offset: 0x01000000
Tags Offset:    0x00000100
DTB Offset:     0x01f00000
Kernel Artifact: $KERNEL_OUT/arch/arm64/boot/Image.gz
DTB Artifact:    $KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb
EOF
}

cmd_pack() {
  local out_img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  local kernel="$KERNEL_OUT/arch/arm64/boot/Image.gz"
  local dtb="$KERNEL_OUT/arch/arm64/boot/dts/qcom/sm8250-samsung-r8q.dtb"
  local cache_dir="$HOME/.cache/omamobile/alpine"
  local ver="3.24.2"
  local tarball="alpine-minirootfs-$ver-aarch64.tar.gz"

  [[ -f $kernel ]] || die "Kernel not found at $kernel (run bin/omamobile kernel first)"
  [[ -f $dtb ]] || die "DTB not found at $dtb (run bin/omamobile kernel first)"
  [[ -f $MKBOOTIMG ]] || die "mkbootimg tool not found at $MKBOOTIMG"

  local stage
  stage=$(mktemp -d)

  say "Staging Alpine Linux ARM64 rootfs in $stage"
  mkdir -p "$stage/root" "$cache_dir/apks"
  tar -xzf "$cache_dir/$tarball" -C "$stage/root"

  say "Fetching and staging packages (dropbear, kexec-tools, e2fsprogs)"
  local apks
  apks=$(python3 -I "$ROOT/tools/alpine-fetch.py" "$ver" "$cache_dir/apks" dropbear kexec-tools e2fsprogs e2fsprogs-extra) ||
    die "alpine-fetch.py failed"
  for apk in $apks; do
    tar -xzf "$apk" -C "$stage/root" --exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.*.sh' 2>/dev/null || true
  done

  # Stage shared initramfs init
  cp "$ROOT/initramfs/init" "$stage/root/init"
  chmod 755 "$stage/root/init"

  # Force storage guard into 100% read-only mode for r8q bring-up
  touch "$stage/root/etc/omamobile-ufs-rw"
  chmod 644 "$stage/root/etc/omamobile-ufs-rw"
  echo "Samsung Galaxy S20 FE (r8q)" > "$stage/root/etc/omamobile-usb-product"

  # Stage SSH authorized keys from host if available
  mkdir -p "$stage/root/etc/dropbear"
  for keyfile in "$HOME"/.ssh/id_*.pub; do
    if [[ -f $keyfile ]]; then
      cat "$keyfile" >> "$stage/root/etc/dropbear/authorized_keys"
    fi
  done
  if [[ -f "$stage/root/etc/dropbear/authorized_keys" ]]; then
    chmod 600 "$stage/root/etc/dropbear/authorized_keys"
  fi

  # Build cpio ramdisk
  local ramdisk="$stage/initramfs.cpio.gz"
  say "Creating compressed initramfs ramdisk"
  (
    cd "$stage/root"
    find . -mindepth 1 | cpio -H newc -o 2>/dev/null | gzip -9 -n > "$ramdisk"
  )

  say "Packing Android header-v2 image: $out_img"
  mkdir -p "$(dirname "$out_img")"

  python3 "$MKBOOTIMG" \
    --header_version 2 \
    --pagesize 4096 \
    --base 0x00000000 \
    --kernel_offset 0x00008000 \
    --ramdisk_offset 0x01000000 \
    --tags_offset 0x00000100 \
    --dtb_offset 0x01f00000 \
    --cmdline "console=tty0 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init omamobile.ufs-probe" \
    --kernel "$kernel" \
    --ramdisk "$ramdisk" \
    --dtb "$dtb" \
    --output "$out_img"

  say "Image packed successfully:"
  rm -rf "$stage"
  ls -lh "$out_img"
  sha256sum "$out_img"
}

cmd_verify() {
  local img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  [[ -f $img ]] || die "Image not found at $img"
  say "Verifying image: $img"
  ls -lh "$img"
  sha256sum "$img"
  local magic
  magic=$(dd if="$img" bs=8 count=1 2>/dev/null)
  if [[ $magic == "ANDROID!" ]]; then
    say "Magic check: ANDROID! header verified"
  else
    die "Invalid magic bytes in $img: '$magic' (expected ANDROID!)"
  fi
}

cmd_flash_recovery() {
  local img="${1:-$KERNEL_OUT/recovery-omamobile.img}"
  local backup_dir="$HOME/android/backups/r8q-nv"
  local expected_boot_sha="2210cd703c8ab9ea96874a071a362bc088dddc2b4df524d0e8be767a26b3e3b4"

  [[ -f $img ]] || die "Image not found at $img (run pack first)"
  [[ -d $backup_dir ]] || die "Backup directory not found at $backup_dir"

  say "Safety check 1: Checking adb connection to phone"
  adb get-state >/dev/null 2>&1 || die "Phone not detected over adb"

  say "Safety check 2: Verifying primary LineageOS boot partition (sda23) is untouched"
  local live_boot_sha
  live_boot_sha=$(adb shell "sha256sum /dev/block/by-name/boot 2>/dev/null | awk '{print \$1}'" | tr -d '\r\n')
  [[ $live_boot_sha == "$expected_boot_sha" ]] || die "Boot partition sha mismatch! Expected $expected_boot_sha, got '$live_boot_sha'"
  say "LineageOS primary boot slot is 100% verified and untouched ($live_boot_sha)"

  say "Pushing test recovery image to /data/local/tmp/"
  local img_sha img_bytes
  img_sha=$(sha256sum "$img" | awk '{print $1}')
  img_bytes=$(stat -c%s "$img")
  adb push "$img" /data/local/tmp/recovery-omamobile.img >/dev/null

  say "Verifying pushed image checksum on phone"
  local pushed_sha
  pushed_sha=$(adb shell "sha256sum /data/local/tmp/recovery-omamobile.img 2>/dev/null | awk '{print \$1}'" | tr -d '\r\n')
  [[ $pushed_sha == "$img_sha" ]] || die "Pushed image checksum mismatch on phone"

  say "Writing test recovery image to /dev/block/by-name/recovery (sda24)"
  adb shell "dd if=/data/local/tmp/recovery-omamobile.img of=/dev/block/by-name/recovery bs=4096 conv=fsync 2>/dev/null"
  adb shell "rm -f /data/local/tmp/recovery-omamobile.img"

  say "Verifying recovery partition readback checksum"
  local blocks=$(( (img_bytes + 4095) / 4096 ))
  local readback_sha
  readback_sha=$(adb shell "dd if=/dev/block/by-name/recovery bs=4096 count=$blocks 2>/dev/null | head -c $img_bytes | sha256sum | awk '{print \$1}'" | tr -d '\r\n')
  [[ $readback_sha == "$img_sha" ]] || die "Recovery readback checksum mismatch ($readback_sha != $img_sha)"

  say "Recovery partition successfully updated and verified ($img_sha)"
  say "Rebooting into test recovery image..."
  adb reboot recovery
  say "Phone rebooted to recovery. Waiting for USB network gadget on 172.16.42.1..."
}

cmd_restore_recovery() {
  local backup="$HOME/android/backups/r8q-nv/recovery.img"
  local expected_sha="36855fb919f3af98d0e4e45692672d4a96989e9090a4cc882754139543cfef35"

  [[ -f $backup ]] || die "Stock recovery backup not found at $backup"
  say "Safety check: checking adb connection"
  adb get-state >/dev/null 2>&1 || die "Phone not detected over adb"

  say "Restoring stock LineageOS recovery from $backup"
  adb push "$backup" /data/local/tmp/recovery.img >/dev/null
  adb shell "dd if=/data/local/tmp/recovery.img of=/dev/block/by-name/recovery bs=4096 conv=fsync 2>/dev/null"
  adb shell "rm -f /data/local/tmp/recovery.img"

  local restored_sha
  restored_sha=$(adb shell "sha256sum /dev/block/by-name/recovery | awk '{print \$1}'" | tr -d '\r\n')
  [[ $restored_sha == "$expected_sha" ]] || die "Restore sha mismatch!"
  say "Stock LineageOS recovery successfully restored and verified ($restored_sha)"
}

cmd="${1:-}"
shift || true
case $cmd in
  pack) cmd_pack "$@" ;;
  verify) cmd_verify "$@" ;;
  flash-recovery) cmd_flash_recovery "$@" ;;
  restore-recovery) cmd_restore_recovery ;;
  info) cmd_info ;;
  *) usage; exit 1 ;;
esac
