#!/bin/bash
# SPDX-License-Identifier: MIT
# r8q-camera-bringup: Gated camera bring-up sequence for Samsung Galaxy S20 FE (r8q).
#
# Automates camera bring-up (keeping --dual-boot and display):
#   1. Verify camera modules and current media/video nodes on the phone
#   2. Pack recovery image with display + camera overlays
#   3. Flash to sda24 and reboot into recovery
#   4. Verify CAMSS media graph (/dev/media0, /dev/video*)
#   5. Check HI-847 sensor on QUP I2C10 (10-0021)
#
# Usage: tools/r8q-camera-bringup [--step N] [--dry-run] [--yes]
#
# Rollback:
#   tools/r8q-boot pack --dual-boot --overlay display
#   tools/r8q-flash-recovery

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KERNEL_OUT="${KERNEL_OUT:-$HOME/omamobile-kernel/out-r8q}"
STEP="${STEP:-1}"
DRY_RUN="${DRY_RUN:-0}"
AUTO_YES="${AUTO_YES:-0}"
SSH_KEY="${OMAMOBILE_SSH_KEY:-$HOME/.ssh/omamobile-r8q}"

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }
dry() { [[ $DRY_RUN -eq 1 ]] && { say "[DRY RUN] $*"; return 0; } || return 1; }

usage() {
  cat <<EOF
Usage: tools/r8q-camera-bringup [OPTIONS]

Options:
  --step N     Start at step N (1-5, default: 1)
  --dry-run    Print commands without executing
  --yes        Skip interactive flash/reboot confirmation prompts
  --help       Show this help

Steps:
  1. Verify camera modules installed/loaded
  2. Pack recovery with display + camera overlays
  3. Flash to sda24 and reboot into recovery
  4. Verify CAMSS media graph
  5. Check HI-847 sensor on I2C10

Rollback:
  tools/r8q-boot pack --dual-boot --overlay display
  tools/r8q-flash-recovery
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --step) STEP="${2:?--step requires a number}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) AUTO_YES=1; shift ;;
    --help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
done

phone_ssh() {
  if [[ -f "$SSH_KEY" ]]; then
    OMAMOBILE_SSH_KEY="$SSH_KEY" "$ROOT/tools/phone-ssh" "$@"
  else
    "$ROOT/tools/phone-ssh" "$@"
  fi
}

confirm_action() {
  local prompt="$1"
  [[ $AUTO_YES -eq 1 ]] && return 0
  read -r -p "$prompt [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || die "Aborted by user"
}

wait_for_phone() {
  say "Waiting for phone (172.16.42.1)..."
  for _ in $(seq 1 30); do
    phone_ssh true 2>/dev/null && return 0
    sleep 4
  done
  die "Phone did not answer over SSH after 2 minutes"
}

check_modules() {
  say "Checking camera modules..."
  phone_ssh '
    kver=$(uname -r)
    for mod in camcc_sm8250 qcom_camss hi847 i2c_qcom_cci; do
      state="NOT loaded"
      lsmod | grep -c "^${mod} " >/dev/null && state="loaded"
      on_disk="missing"
      find "/lib/modules/$kver" -name "${mod//_/-}.ko*" -o -name "${mod}.ko*" 2>/dev/null | grep -c . >/dev/null && on_disk="present"
      echo "$mod: $state (module $on_disk)"
    done
    echo "---"
    echo "Media devices:"
    ls /dev/media* 2>/dev/null || echo "  none"
    echo "Video devices:"
    ls /dev/video* 2>/dev/null || echo "  none"
  '
}

check_camss_graph() {
  say "Checking CAMSS media graph..."
  phone_ssh '
    if [ -e /dev/media0 ]; then
      if command -v media-ctl >/dev/null 2>&1; then
        media-ctl -d /dev/media0 -p | sed -n '1,40p'
      else
        echo "media-ctl not installed (v4l-utils)"
      fi
    else
      echo "No /dev/media0 found"
    fi
  '
}

check_hi847() {
  say "Checking HI-847 sensor on I2C10..."
  phone_ssh '
    echo "I2C10 bus scan:"
    i2cdetect -y 10 2>/dev/null || echo "  i2cdetect not available or bus 10 missing"
    echo "---"
    echo "HI-847 at 10-0021:"
    if [ -e /sys/bus/i2c/devices/10-0021 ]; then
      echo "  Found at 10-0021 ($(cat /sys/bus/i2c/devices/10-0021/name 2>/dev/null || echo unknown))"
      [ -L /sys/bus/i2c/devices/10-0021/driver ] &&
        echo "  Driver: $(basename "$(readlink /sys/bus/i2c/devices/10-0021/driver)")" ||
        echo "  Driver: unbound"
    else
      echo "  Not found at 10-0021"
    fi
    echo "---"
    echo "dmesg camera messages:"
    dmesg | grep -iE "hi847|camss|cci|camera|a88000" | tail -15 || echo "  none"
  '
}

flash_with_camera() {
  local img="${KERNEL_OUT}/recovery-omamobile-camera.img"
  local -a ov_args=(--dual-boot --overlay display --overlay camera)

  say "Packing recovery image (${ov_args[*]}) -> $img"
  if ! dry "tools/r8q-boot pack ${ov_args[*]} $img"; then
    "$ROOT/tools/r8q-boot" pack "${ov_args[@]}" "$img"
  fi

  if [[ $STEP -le 3 ]]; then
    say "Flashing $img to sda24 and rebooting into recovery..."
    if ! dry "OMAMOBILE_SSH_KEY=$SSH_KEY tools/r8q-flash-recovery $img && reboot recovery"; then
      confirm_action "Flash $img to /dev/sda24 and reboot the phone into recovery?"
      OMAMOBILE_SSH_KEY="$SSH_KEY" "$ROOT/tools/r8q-flash-recovery" "$img"
      phone_ssh "reboot recovery" || true
      sleep 5
      wait_for_phone
    fi
  fi
}

say "=== r8q Camera Bring-Up Sequence ==="
say "Starting at step $STEP"

if [[ $STEP -le 1 ]]; then
  [[ $DRY_RUN -eq 1 ]] && say "[DRY RUN] Check camera modules" || {
    wait_for_phone
    check_modules
  }
fi

if [[ $STEP -le 3 ]]; then
  flash_with_camera
fi

if [[ $STEP -le 4 ]]; then
  [[ $DRY_RUN -eq 1 ]] && say "[DRY RUN] Verify CAMSS media graph" || {
    wait_for_phone
    check_camss_graph
  }
fi

if [[ $STEP -le 5 ]]; then
  [[ $DRY_RUN -eq 1 ]] && say "[DRY RUN] Check HI-847 sensor" || {
    check_hi847
  }
fi

say "=== Camera Bring-Up Sequence Complete ==="
say "Rollback: tools/r8q-boot pack --dual-boot --overlay display && tools/r8q-flash-recovery"
