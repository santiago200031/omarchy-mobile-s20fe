# tools/r8q-common: shared bits for the small r8q USB tools.
# Sourced, never executed. Keeps the one-liners every tool repeats — log
# helpers, the USB-SSH options, and wait-for-phone — in a single place so
# r8q-optimize (perf), r8q-stabilize (live-apply + facts) and r8q-rescue
# (emergency stop + facts) stay small and single-purpose.
#
# Usage in a tool:
#   ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
#   . "$ROOT/tools/r8q-common"
#   REMOTE="${1:-root@172.16.42.1}"
#   r8q_wait "$REMOTE" 60 4
say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

# One SSH shape for every r8q USB tool: no host-key prompts (recovery and
# Arch share the address), short connect timeout, keepalive for long flashes.
R8Q_SSH=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -o ServerAliveInterval=5 -q)

# r8q_wait <remote> [tries] [sleep]: wait until ssh answers.
r8q_wait() {
  local remote="${1:?usage: r8q_wait <remote> [tries] [sleep]}"
  local tries="${2:-60}" sl="${3:-4}" i
  for i in $(seq 1 "$tries"); do
    "${R8Q_SSH[@]}" "$remote" true >/dev/null 2>&1 && return 0
    sleep "$sl"
  done
  return 1
}
