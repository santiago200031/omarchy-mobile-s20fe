#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# tools/r8q-extract-firmware: extract and squash Qualcomm SM8250 firmware from running Galaxy S20 FE
import hashlib, os, shutil, struct, subprocess, sys, urllib.request

say = lambda msg: print(f"\033[1;34m==>\033[0m {msg}")
die = lambda msg: (print(f"\033[1;31mERROR:\033[0m {msg}", file=sys.stderr), sys.exit(1))

OUT_DIR = os.path.expanduser("~/.cache/omamobile/firmware/r8q/lib/firmware")
STAGE_DIR = "/tmp/r8q-fw-stage"
MIN_SQE_VERSION = 0x095
UPSTREAM_SQE_URL = "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/qcom/a650_sqe.fw"
UPSTREAM_SQE_SHA256 = "c863ceac3a823af215205d7803776bfdc68098c2c2a5d2fd05b4aa77cd336b4b"

def sqe_version(path):
    with open(path, "rb") as f:
        hdr = f.read(8)
    if len(hdr) < 8:
        return None
    return struct.unpack("<I", hdr[4:8])[0] & 0xfff

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

def ensure_upstream_sqe(dest_path):
    candidates = [
        os.environ.get("OMAMOBILE_SQE_FW", ""),
        "/usr/lib/firmware/qcom/a650_sqe.fw",
        "/tmp/upstream-a650_sqe.fw",
    ]
    for cand in candidates:
        if cand and os.path.isfile(cand):
            ver = sqe_version(cand)
            if ver is not None and ver >= MIN_SQE_VERSION:
                shutil.copy2(cand, dest_path)
                say(f"Using local upstream a650_sqe.fw ({cand}, fw 0x{ver:03x})")
                return
    say("Vendor a650_sqe.fw is too old (< 0x095); fetching verified upstream linux-firmware...")
    tmp_dl = os.path.join(STAGE_DIR, "upstream-a650_sqe.fw")
    try:
        urllib.request.urlretrieve(UPSTREAM_SQE_URL, tmp_dl)
    except Exception as exc:
        die(f"Cannot fetch upstream a650_sqe.fw ({exc}); pass OMAMOBILE_SQE_FW=...")
    got_sha = sha256_file(tmp_dl)
    if got_sha != UPSTREAM_SQE_SHA256:
        die(f"Upstream a650_sqe.fw sha256 mismatch: got {got_sha}, expected {UPSTREAM_SQE_SHA256}")
    ver = sqe_version(tmp_dl)
    if ver is None or ver < MIN_SQE_VERSION:
        die(f"Upstream a650_sqe.fw version 0x{ver or 0:03x} < 0x{MIN_SQE_VERSION:03x}")
    shutil.copy2(tmp_dl, dest_path)
    say(f"Verified upstream a650_sqe.fw (fw 0x{ver:03x}, sha256 {got_sha[:12]}...)")

def run(cmd, capture=False):
    res = subprocess.run(cmd, shell=True, text=True, stdout=subprocess.PIPE if capture else None, stderr=subprocess.PIPE if capture else None)
    if res.returncode != 0:
        die(f"Command failed: {cmd}\n{res.stderr if capture else ''}")
    return res.stdout if capture else None

def check_adb():
    devs = run("adb devices", capture=True)
    if "\tdevice" not in devs:
        die("Galaxy S20 FE not detected over adb (check cable or unlock screen)")

def squash_mdt(mdt_file, out_file):
    with open(mdt_file, "rb") as f:
        header = f.read(64)
    if header[:4] != b"\x7fELF":
        die(f"{mdt_file} is not an ELF file")
    is_64 = header[4] == 2
    e_phoff = struct.unpack("<Q" if is_64 else "<I", header[32:40] if is_64 else header[28:32])[0]
    e_phentsize = struct.unpack("<H", header[54:56] if is_64 else header[42:44])[0]
    e_phnum = struct.unpack("<H", header[56:58] if is_64 else header[44:46])[0]
    
    with open(mdt_file, "rb") as f:
        f.seek(0)
        out_data = bytearray(f.read())
    
    base_dir = os.path.dirname(mdt_file)
    prefix = os.path.splitext(os.path.basename(mdt_file))[0]
    
    with open(mdt_file, "rb") as f:
        f.seek(e_phoff)
        for i in range(e_phnum):
            ph = f.read(e_phentsize)
            if is_64:
                p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = struct.unpack("<IIQQQQQQ", ph[:56])
            else:
                p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align = struct.unpack("<IIIIIIII", ph[:32])
            
            b_file = os.path.join(base_dir, f"{prefix}.b{i:02d}")
            if os.path.exists(b_file) and p_filesz > 0:
                with open(b_file, "rb") as bf:
                    seg_data = bf.read()
                if len(out_data) < p_offset + p_filesz:
                    out_data.extend(b"\x00" * (p_offset + p_filesz - len(out_data)))
                out_data[p_offset:p_offset + p_filesz] = seg_data
    
    os.makedirs(os.path.dirname(out_file), exist_ok=True)
    with open(out_file, "wb") as out:
        out.write(out_data)
    say(f"Squashed {os.path.basename(mdt_file)} -> {out_file} ({len(out_data):,} bytes)")

def main():
    check_adb()
    os.makedirs(OUT_DIR, exist_ok=True)
    os.makedirs(STAGE_DIR, exist_ok=True)

    say(f"Extracting vendor firmware from device to {OUT_DIR}...")

    # 1. GPU Firmware: Adreno 650
    qcom_dir = os.path.join(OUT_DIR, "qcom")
    sm8250_dir = os.path.join(OUT_DIR, "qcom/sm8250")
    dsp_target_dir = os.path.join(OUT_DIR, "qcom/sm8250/samsung/r8q")
    os.makedirs(qcom_dir, exist_ok=True)
    os.makedirs(sm8250_dir, exist_ok=True)
    os.makedirs(dsp_target_dir, exist_ok=True)

    say("Pulling Adreno 650 GMU and SQE microcode...")
    run(f"adb pull /vendor/firmware/a650_gmu.bin {qcom_dir}/a650_gmu.bin >/dev/null")
    run(f"adb pull /vendor/firmware/a650_sqe.fw {qcom_dir}/a650_sqe.fw >/dev/null")
    ver = sqe_version(f"{qcom_dir}/a650_sqe.fw")
    if ver is None or ver < MIN_SQE_VERSION:
        say(f"Vendor a650_sqe.fw version 0x{ver or 0:03x} < 0x{MIN_SQE_VERSION:03x} (mainline a650 requires >= 0x095)")
        ensure_upstream_sqe(f"{qcom_dir}/a650_sqe.fw")
    # Also stage in sm8250 dir for different driver lookup conventions
    run(f"cp {qcom_dir}/a650_gmu.bin {sm8250_dir}/a650_gmu.bin")
    run(f"cp {qcom_dir}/a650_sqe.fw {sm8250_dir}/a650_sqe.fw")

    say("Pulling and squashing a650_zap shader firmware...")
    run(f"adb shell \"sh -c 'cd /vendor/firmware_mnt/image && tar -cf - a650_zap.*'\" | tar -C {STAGE_DIR}/ -xf -")
    squash_mdt(f"{STAGE_DIR}/a650_zap.mdt", f"{dsp_target_dir}/a650_zap.mbn")
    run(f"cp {dsp_target_dir}/a650_zap.mbn {qcom_dir}/a650_zap.mbn")
    run(f"cp {dsp_target_dir}/a650_zap.mbn {sm8250_dir}/a650_zap.mbn")

    # 2. Subsystem DSPs: ADSP, CDSP, SLPI, VENUS
    for dsp in ["adsp", "cdsp", "slpi", "venus"]:
        say(f"Pulling and squashing {dsp} firmware...")
        run(f"adb shell \"sh -c 'cd /vendor/firmware_mnt/image && tar -cf - {dsp}.*'\" | tar -C {STAGE_DIR}/ -xf - 2>/dev/null || true")
        if os.path.exists(f"{STAGE_DIR}/{dsp}.mdt"):
            squash_mdt(f"{STAGE_DIR}/{dsp}.mdt", f"{dsp_target_dir}/{dsp}.mbn")
            run(f"cp {dsp_target_dir}/{dsp}.mbn {sm8250_dir}/{dsp}.mbn")

    say("Pulling DSP JSON descriptor configs...")
    run(f"adb shell \"sh -c 'cd /vendor/firmware_mnt/image && tar -cf - *.jsn'\" | tar -C {dsp_target_dir}/ -xf - 2>/dev/null || true")
    run(f"cp {dsp_target_dir}/*.jsn {sm8250_dir}/ 2>/dev/null || true")

    # 3. Audio Amplifiers: Cirrus CS35L40
    cirrus_dir = os.path.join(OUT_DIR, "cirrus")
    os.makedirs(cirrus_dir, exist_ok=True)
    say("Pulling Cirrus CS35L40 speaker amplifier firmware...")
    run(f"adb shell \"sh -c 'cd /vendor/firmware && tar -cf - cs35l40-*'\" | tar -C {cirrus_dir}/ -xf -")
    for dst, src in [
        ("cs35l41-dsp1-spk-prot-r8q-right.wmfw", "cs35l40-bot-dsp1-spk-prot.wmfw"),
        ("cs35l41-dsp1-spk-prot-r8q-right.bin", "cs35l40-bot-dsp1-spk-prot.bin"),
        ("cs35l41-dsp1-spk-prot-r8q-left.wmfw", "cs35l40-rcv-dsp1-spk-prot.wmfw"),
        ("cs35l41-dsp1-spk-prot-r8q-left.bin", "cs35l40-rcv-dsp1-spk-prot.bin"),
    ]:
        src_path = os.path.join(cirrus_dir, src)
        dst_path = os.path.join(cirrus_dir, dst)
        if os.path.exists(src_path):
            if os.path.lexists(dst_path):
                os.remove(dst_path)
            os.symlink(src, dst_path)

    # 4. Bluetooth: QCA (WCN685x / QCA6390)
    qca_dir = os.path.join(OUT_DIR, "qca")
    os.makedirs(qca_dir, exist_ok=True)
    say("Pulling Bluetooth QCA firmware (htbtfw20.tlv, htnv20.bin)...")
    run(f"adb pull /vendor/firmware/htbtfw20.tlv {qca_dir}/htbtfw20.tlv >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/htnv20.bin {qca_dir}/htnv20.bin >/dev/null 2>&1 || true")

    # 5. Wi-Fi: QCA6390 ath11k
    ath_dir = os.path.join(OUT_DIR, "ath11k/QCA6390/hw2.0")
    os.makedirs(ath_dir, exist_ok=True)
    say("Pulling and staging QCA6390 Wi-Fi 6 ath11k firmware...")
    run(f"adb pull /vendor/firmware/qca6390/amss20.bin {ath_dir}/amss.bin >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/qca6390/m3.bin {ath_dir}/m3.bin >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/qca6390/regdb.bin {ath_dir}/regdb.bin >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/qca6390/bdwlan.elf {ath_dir}/board.bin >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/qca6390/bdwlan.elf {ath_dir}/bdwlan.bin >/dev/null 2>&1 || true")
    if os.path.exists(f"{ath_dir}/board-2.bin"):
        os.remove(f"{ath_dir}/board-2.bin")

    # 6. Modem: SDX55 / r8q CP firmware
    say("Pulling modem firmware from /vendor/firmware-modem...")
    run(f"adb pull /vendor/firmware-modem/image/sdx55m/qdsp6sw.mbn {dsp_target_dir}/modem.mbn >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware-modem/image/sdx55m/modemr.jsn {dsp_target_dir}/modemr.jsn >/dev/null 2>&1 || true")
    run(f"cp {dsp_target_dir}/modem.mbn {sm8250_dir}/modem.mbn 2>/dev/null || true")
    run(f"cp {dsp_target_dir}/modemr.jsn {sm8250_dir}/modemr.jsn 2>/dev/null || true")

    # 7. IPA Firmware: ipa_fws and ipa_uc
    say("Pulling and squashing IPA firmware...")
    run(f"adb shell \"sh -c 'cd /vendor/firmware && tar -cf - ipa_fws.* ipa_uc.*'\" | tar -C {STAGE_DIR}/ -xf - 2>/dev/null || true")
    if os.path.exists(f"{STAGE_DIR}/ipa_fws.mdt"):
        squash_mdt(f"{STAGE_DIR}/ipa_fws.mdt", f"{dsp_target_dir}/ipa_fws.mbn")
        run(f"cp {dsp_target_dir}/ipa_fws.mbn {sm8250_dir}/ipa_fws.mbn")
        run(f"cp {dsp_target_dir}/ipa_fws.mbn {qcom_dir}/ipa_fws.mbn")
        run(f"cp {dsp_target_dir}/ipa_fws.mbn {OUT_DIR}/ipa_fws.mbn")
    if os.path.exists(f"{STAGE_DIR}/ipa_uc.mdt"):
        squash_mdt(f"{STAGE_DIR}/ipa_uc.mdt", f"{dsp_target_dir}/ipa_uc.mbn")
        run(f"cp {dsp_target_dir}/ipa_uc.mbn {sm8250_dir}/ipa_uc.mbn")
        run(f"cp {dsp_target_dir}/ipa_uc.mbn {qcom_dir}/ipa_uc.mbn")
        run(f"cp {dsp_target_dir}/ipa_uc.mbn {OUT_DIR}/ipa_uc.mbn")

    # 8. Haptics: Cirrus CS40L25a / CS40L20
    say("Pulling Cirrus CS40L25a / CS40L20 haptics firmware...")
    run(f"adb shell \"sh -c 'cd /vendor/firmware && tar -cf - cs40l*'\" | tar -C {cirrus_dir}/ -xf - 2>/dev/null || true")
    run(f"cp {cirrus_dir}/cs40l* {OUT_DIR}/ 2>/dev/null || true")

    # 9. Touchkey / Grip sensor: A96T356
    say("Pulling A96T356 touchkey/grip sensor firmware...")
    run(f"adb pull /vendor/firmware/a96t356_r8q_all.bin {OUT_DIR}/a96t356_r8q_all.bin >/dev/null 2>&1 || true")
    run(f"adb pull /vendor/firmware/a96t356_r8q_usa.bin {OUT_DIR}/a96t356_r8q_usa.bin >/dev/null 2>&1 || true")

    say(f"All firmware successfully extracted and squashed into {OUT_DIR}!")
    run(f"rm -rf {STAGE_DIR}")
    run(f"ls -lhR {OUT_DIR} | head -35")

if __name__ == "__main__":
    main()
