#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tools/r8q-optimize: Applies Tier 1 performance optimizations to Omarchy Mobile on Galaxy S20 FE (r8q)
set -euo pipefail

say() { printf '\e[1;34m==>\e[0m %s\n' "$*"; }
ok() { printf '\e[1;32m  ✔\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m  ⚠\e[0m %s\n' "$*"; }
die() { printf '\e[1;31merror:\e[0m %s\n' "$*" >&2; exit 1; }

REMOTE="${1:-root@172.16.42.1}"

SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -q)

say "Checking connection to phone ($REMOTE)..."
ssh "${SSH_OPTS[@]}" "$REMOTE" "echo connected" >/dev/null 2>&1 \
  || die "Cannot connect to $REMOTE. Is USB connected and USB networking active?"
ok "Connected to phone over USB."

say "1. Optimizing Hyprland for software framebuffer (disabling CPU blur/shadows/animations)..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
mkdir -p /home/alarm/.config/hypr

cat << 'HYPRCONF' > /home/alarm/.config/hypr/looknfeel.lua
-- S20 FE (r8q) simpledrm performance optimizations:
-- Mesa llvmpipe software rendering cannot sustain 1080x2400 Dual Kawase blur and shadows
-- Disabling blur, shadow, and animations reduces CPU utilization from ~291% to <10%.
hl.config({
  decoration = {
    blur = { enabled = false },
    shadow = { enabled = false },
    rounding = 8,
  },
  misc = {
    vrr = 0,
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  animations = {
    enabled = false,
  }
})
HYPRCONF

chown alarm:alarm /home/alarm/.config/hypr/looknfeel.lua

# If Hyprland is currently running, reload config live
if pgrep -x Hyprland >/dev/null 2>&1; then
  su - alarm -c 'hyprctl reload' 2>/dev/null || true
fi
EOF
ok "Hyprland performance profile applied (CPU load will drop significantly)."

say "2. Securing USB networking in NetworkManager..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
mkdir -p /etc/NetworkManager/conf.d
cat << 'NMCONF' > /etc/NetworkManager/conf.d/10-omamobile-usb.conf
[keyfile]
unmanaged-devices=interface-name:usb0
NMCONF
systemctl reload NetworkManager 2>/dev/null || systemctl restart NetworkManager 2>/dev/null || true
EOF
ok "NetworkManager configured: usb0 is unmanaged (SSH link is protected)."

say "3. Configuring hardware button modules and logind..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
mkdir -p /etc/modules-load.d /etc/systemd/logind.conf.d
echo "qcom-pon" > /etc/modules-load.d/omamobile-buttons.conf
modprobe qcom-pon 2>/dev/null || true

cat << 'LOGINDCONF' > /etc/systemd/logind.conf.d/10-omamobile-power-key.conf
[Login]
HandlePowerKey=ignore
LOGINDCONF
systemctl restart systemd-logind 2>/dev/null || true
EOF
ok "Hardware keys (Power, Vol+, Vol-) enabled and protected from accidental poweroff."

say "4. Verifying CPU and memory state..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
printf "  Load average: "
uptime | awk -F'load average:' '{print $2}'
printf "  Free memory: "
free -h | grep "Mem:" | awk '{print "Used: "$3" / Total: "$2" (Free: "$4")"}'
printf "  Input devices: "
grep -E 'Name=' /proc/bus/input/devices | awk -F'Name=' '{print $2}' | tr '\n' ', '
echo ""
EOF

ok "Tier 1 optimizations complete!"
