#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tools/r8q-optimize: Tier 1 performance profile for Omarchy Mobile on Galaxy S20 FE (r8q).
# Perf only: Hyprland software-rendering profile, USB guard, suspend refusal,
# serial rescue shell, then a CPU/memory check. For bring-up facts use
# tools/r8q-stabilize; for a wedged phone use tools/r8q-rescue.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC1091
. "$ROOT/tools/r8q-common"

REMOTE="${1:-root@172.16.42.1}"
SSH_OPTS=("${R8Q_SSH[@]:1}")

say "Checking connection to phone ($REMOTE)..."
ssh "${SSH_OPTS[@]}" "$REMOTE" "echo connected" >/dev/null 2>&1 \
  || die "Cannot connect to $REMOTE. Is USB connected and USB networking active?"
ok "Connected to phone over USB."

say "1. Optimizing Hyprland for software framebuffer (disabling CPU blur/shadows/animations)..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
mkdir -p /home/alarm/.config/hypr

cat << 'HYPRCONF' > /home/alarm/.config/hypr/looknfeel.lua
-- S20 FE (r8q) simpledrm performance optimizations:
-- Mesa llvmpipe software rendering cannot sustain 1080x2400 Dual Kawase blur and shadows
-- Disabling blur, shadow, and animations reduces CPU utilization from ~291% to <10%.
hl.config({
  decoration = {
    blur = { enabled = false },
    shadow = { enabled = false },
    rounding = 8,
  },
  misc = {
    vrr = 0,
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  animations = {
    enabled = false,
  }
})
HYPRCONF

chown alarm:alarm /home/alarm/.config/hypr/looknfeel.lua

# If Hyprland is currently running, reload config live
if pgrep -x Hyprland >/dev/null 2>&1; then
  su - alarm -c 'hyprctl reload' 2>/dev/null || true
fi
EOF
ok "Hyprland performance profile applied (CPU load will drop significantly)."

say "2. Securing USB networking in NetworkManager..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
mkdir -p /etc/NetworkManager/conf.d
cat << 'NMCONF' > /etc/NetworkManager/conf.d/10-omamobile-usb.conf
[keyfile]
unmanaged-devices=interface-name:usb0
NMCONF
systemctl reload NetworkManager 2>/dev/null || systemctl restart NetworkManager 2>/dev/null || true
EOF
ok "NetworkManager configured: usb0 is unmanaged (SSH link is protected)."

say "3. Disabling broken s2idle sleep (logind gate, seat idle, masked targets)..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
set -eu
# The one gate every suspend caller goes through. On this port s2idle never
# wakes: the phone freezes until a PMIC hard reset.
install -d /etc/systemd/sleep.conf.d
cat > /etc/systemd/sleep.conf.d/10-r8q-no-suspend.conf << 'SLEEPCONF'
[Sleep]
AllowSuspend=no
AllowHibernation=no
AllowSuspendThenHibernate=no
AllowHybridSleep=no
SLEEPCONF

install -d /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/10-r8q-no-idle.conf << 'LOGINDCONF'
[Login]
HandlePowerKey=ignore
HandleSuspendKey=ignore
HandleHibernateKey=ignore
HandleLidSwitch=ignore
IdleAction=ignore
LOGINDCONF

# Anything that calls the targets directly, plus the kernel command line's
# systemd.mask=, are the other two layers.
systemctl mask --quiet sleep.target suspend.target hibernate.target \
  hybrid-sleep.target suspend-then-hibernate.target 2>/dev/null || true
systemctl daemon-reload
systemctl restart systemd-logind 2>/dev/null || true

# Omarchy Mobile's own screen-off sleep watcher: off by default, keep it off.
mkdir -p /etc/systemd/user
ln -sfn /dev/null /etc/systemd/user/omamobile-sleepd.service
systemctl --user -M alarm@ mask --quiet omamobile-sleepd.service 2>/dev/null || true
systemctl --user -M alarm@ stop --quiet omamobile-sleepd.service 2>/dev/null || true
rm -f /home/alarm/.local/state/omarchy/toggles/omamobile-sleep

# A rescue shell on the USB serial port, for when the network stack or the
# session wedges (the kernel console is on the same port).
systemctl enable --quiet serial-getty@ttyGS0.service 2>/dev/null || true
EOF
ok "Suspend refused at every layer; serial rescue shell enabled."

say "4. Verifying CPU and memory state..."
ssh "${SSH_OPTS[@]}" "$REMOTE" 'bash -s' << 'EOF'
printf "  Load average: "
uptime | awk -F'load average:' '{print $2}'
printf "  Free memory: "
free -h | grep "Mem:" | awk '{print "Used: "$3" / Total: "$2" (Free: "$4")"}'
printf "  Input devices: "
grep -E 'Name=' /proc/bus/input/devices | awk -F'Name=' '{print $2}' | tr '\n' ', '
echo ""
EOF

ok "Tier 1 optimizations complete!"
